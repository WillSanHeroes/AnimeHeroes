[Info]
Name = "Torre de la Justicia"
displayname = "Tower of Justice"
author = "Team OP OS\n ReEdit: Daniel's" 
mugenversion=1.1
;AttachedChar = ArenasSystem\RO.chr
;--------------------------------------------------------
[camera]
startx = 0
starty = 0
boundleft = -150; -120;
boundright = 150; 120;
boundhigh=-380 
boundlow =0
floortension = 100
tension =190;120
verticalfollow = .6
floortension = 99
overdrawhigh 	= 120
overdrawlow 	= 120
cuthigh = 0
cutlow = 0
zoomin = 1.3
zoomout = .55

;--------------------------------------------------------
[CONSTANTS]
;++RING OUT SYSTEM SECTION+++ 
;para el amigo Gacel, lo prometido es deuda. 
;Gracias por todo el esfuerzo que has puesto al motor.

RingOut_Enable = 1;       Change to 0 to disable Ring Outs   
Left_Limit_RingOut = -425;You can also use debug to help yourself 
Right_Limit_RingOut = 425;to data required from P1

Show_Help_Arrows = 0;     Change to 1 to see bound limits

Only_SelfState_Players = 0; Change to 1 to disable RO if you are in CustomState
Only_Knocked_Players = 1; Change to 1 to disable RO unless Hitfall
Only_NoCtrl_Players = 1;  Change to 1 to disable RO unless Player has no CTRL
Only_Fast_Players = 2;    Change to > 0 to disable RO unless player has at least that speed
Only_High_Players = -35;    Change to < 0 to disable RO unless player is at least above that height

RingOut_Announcer = 1;    0 and 1 are SC, 2 is VF, 3 is Fatal Fury
RingOut_FX = 1;           0 is SC font, 1 is golden, 2 is Fatal Fury
RingOut_Falling = 1;	  Change to 0 to disable "player falling" effect
RingOut_Priority = 1;	  Change to 1 to make the "player falling" effect go on everything

Cheer_System_Enable = 0;0 is Disabled, ID 1 for the BGCtrl to be shown during the frantic moment

Bury_Edge_Limit = 180; Character is at least 180 pixels away from either Stage Edge
Bury_Animation = 1;0 is Disabled, 1 is enabled

RingOut_ResetWalls = 1;   Change to 0 to NOT have invisible walls recover between rounds

RingOut_LeftWall_Health = 50; Self Explanatory - set to zero to have no left wall, each wall hit removes 35
RingOut_LeftWall_Only_SelfState_Players = 0; Change to 1 to disable damage to wall if you are in CustomState
RingOut_LeftWall_Only_Knocked_Players = 1; Change to 1 to disable damage to wall unless Hitfall
RingOut_LeftWall_Only_Hit_Players = 1;     Change to 1 to disable damage to wall unless MoveType = H
RingOut_LeftWall_Only_NoCtrl_Players = 1;  Change to 1 to disable damage to wall unless Player has no CTRL
RingOut_LeftWall_Only_Fast_Players = 3;    Change to > 0 to disable damage to wall unless player has at least that speed
RingOut_LeftWall_Only_High_Players = -35;    Change to < 0 to disable damage to wall unless player is at least above that height

RingOut_RightWall_Health = 50; Self Explanatory - set to zero to have no right wall, each wall hit removes 35
RingOut_RightWall_Only_SelfState_Players = 0; Change to 1 to disable damage to wall if you are in CustomState
RingOut_RightWall_Only_Knocked_Players = 1; Change to 1 to disable damage to wall unless Hitfall
RingOut_RightWall_Only_Hit_Players = 1;     Change to 1 to disable damage to wall unless MoveType = H
RingOut_RightWall_Only_NoCtrl_Players = 1;  Change to 1 to disable damage to wall unless Player has no CTRL
RingOut_RightWall_Only_Fast_Players = 3;    Change to > 0 to disable damage to wall unless player has at least that speed
RingOut_RightWall_Only_High_Players = -35;    Change to < 0 to disable damage to wall unless player is at least above that height

;--------------------------------------------------------
[PlayerInfo]
;--- Player 1 ---
p1startx = -90          ;Starting x coordinates
p1starty = 0            ;Starting y coordinates
p1startz = 0            ;Starting z coordinates
p1facing = 1            ;Direction player faces: 1=right, -1=left
;--- Player 2 ---
p2startx = 90
p2starty = 0
p2startz = 0
p2facing = -1
;--- Player 3 ---
p3startx = -120
p3starty = 0
p3facing = 1
;--- Player 4 ---
p4startx =120
p4starty = 0
p4facing = -1
;--- Common ---
leftbound = -4000
rightbound = 4000
topbound = 0
botbound = 0

;--------------------------------
[Bound]
screenleft = 25
screenright = 25
;--------------------------------
[StageInfo]
zoffset = 185
zoffsetlink = 30 
autoturn = 1
resetBG = 1
localcoord=384,216
hires = 1
;--------------------------------
[Shadow]
color = 26,26,26
yscale = .20
;--------------------------------
[Music]
bgmusic = sound/JusticeTower.mp3
bgmvolume = 255
;---------------------
[bgdef]
spr = JusticeTower.sff
debugbg = 0


