;--------------------------------------------------------
[Info]
name = "Ruins of Greedia"
author = "xcheatdeath" ;Credit to lamissfairy for the stage sprite rips
;attachedchar = UWE\water.chr
;--------------------------------------------------------
[Camera]
startx = 0
starty = 0
boundleft = -315
boundright = 315
boundhigh = -210
boundlow=0
verticalfollow = 0.2
floortension = 140
tension = 100
overdrawhigh = 0
overdrawlow = 0
zoomin = 1.3
zoomout = .8

;--------------------------------------------------------
[PlayerInfo]
;--- Player 1 ---
 ;Player 1 starting coordinates.
 ;p1startx is typically -70 and p2startx is 70.
 ;p1starty and p1startz should be 0.
p1startx = -70          ;Starting x coordinates
p1starty = 0            ;Starting y coordinates
p1startz = 0            ;Starting z coordinates
p1facing = 1            ;Direction player faces: 1=right, -1=left

;--- Player 2 ---
p2startx = 70
p2starty = 0
p2startz = 0
p2facing = -1

;--- Common ---
 ;Don't change these values.
leftbound  = -1000 ;Left bound (x-movement)
rightbound =  1000 ;Right bound
topbound  =  0     ;Top bound (z-movement)
botbound  =  0     ;Bottom bound

;--------------------------------------------------------
[Scaling]
topz     = 0       ;Top z-coordinate for scaling
botz     = 50      ;Bottom z-coordinate for scaling
topscale = 1       ;Scale to use at top
botscale = 1.2     ;Scale to use at bottom

;--------------------------------------------------------
[Bound]
screenleft = 25   ;Dist from left of screen that player can move to
screenright = 25   ;Right edge

;--------------------------------------------------------
[StageInfo]
zoffset = 216
autoturn = 1
resetBG = 0

;--------------------------------------------------------
[Shadow]
intensity = 0

;--------------------------------------------------------
[Reflection]
intensity = 128

;--------------------------------------------------------
[Music]
bgmusic = sound/GreediaRuin.mp3
bgmvolume = 255


[BGdef]
spr = stages/GreediaRuin.sff
debugbg = 0

;Order Actions ---------------------------------------------


[BG Sky]
type = anim
actionno = 0
delta = .5,1


[BG WaterfallsMountains]
type = anim
actionno = 2
delta = .65,1

[BG Deer]
type = anim
actionno = 10
delta = .662,1


