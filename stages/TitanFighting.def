;==========================================================

[Info]
Name = "Titan Fight"
author = "Joey Jostar"
;WebSite = http://kazushi.ucoz.com/
;AttachedChar = ArenasSystem\RO.chr

;==========================================================
[Camera]
 ;Camera starting position: Usually 0 for both
 ;***
startx = 0
starty = 0

 ;Left and right bound of camera
 ;You may want to fiddle a bit with these values to make sure the
 ;background doesn't move too far or too little
 ;***
boundleft = -250
boundright =250

 ;High and low bound of camera
 ;High is a negative number. Make is more negative if you want to
 ;camera to be able to move higher.
 ;Low should usually be 0.
 ;If omitted, defaults to -25 and 0 respectively
 ;***
boundhigh = -50
boundlow = 0

 ;This is how much the camera will move vertically towards the
 ;highest player. Valid values are from 0 to 1. A value of 0 will mean
 ;the camera does not move up at all. A value of 1 will makes the camera
 ;follow the highest player.
 ;Typically .2 for normal-sized backgrounds. You may need to pull this
 ;value up for taller backgrounds.
verticalfollow = .2

 ;Minimum vertical distance the highest player has to be from the floor,
 ;before the camera starts to move up to follow him. For extremely
 ;tall stages, a floor tension of about 20-30 coupled with a
 ;vertical-follow of .8 allows the camera to follow the action.
floortension = 0

 ;Horizontal distance player is from edge before camera starts to move
 ;left or right. Typically 50 or 60.
tension = 50

zoomout = .75
zoomin = 1.3
;--------------------------------------------------------
[CONSTANTS]
;++RING OUT SYSTEM SECTION+++ 
;para el amigo Gacel, lo prometido es deuda. 
;Gracias por todo el esfuerzo que has puesto al motor.

RingOut_Enable = 1;       Change to 0 to disable Ring Outs   
Left_Limit_RingOut = -480;You can also use debug to help yourself 
Right_Limit_RingOut = 480;to data required from P1

Show_Help_Arrows = 0;     Change to 1 to see bound limits

Only_SelfState_Players = 0; Change to 1 to disable RO if you are in CustomState
Only_Knocked_Players = 1; Change to 1 to disable RO unless Hitfall
Only_NoCtrl_Players = 1;  Change to 1 to disable RO unless Player has no CTRL
Only_Fast_Players = 2;    Change to > 0 to disable RO unless player has at least that speed
Only_High_Players = -35;    Change to < 0 to disable RO unless player is at least above that height

RingOut_Announcer = 1;    0 and 1 are SC, 2 is VF, 3 is Fatal Fury
RingOut_FX = 1;           0 is SC font, 1 is golden, 2 is Fatal Fury
RingOut_Falling = 1;	  Change to 0 to disable "player falling" effect
RingOut_Priority = 1;	  Change to 1 to make the "player falling" effect go on everything

Cheer_System_Enable = 0;0 is Disabled, ID 1 for the BGCtrl to be shown during the frantic moment

Bury_Edge_Limit = 180; Character is at least 180 pixels away from either Stage Edge
Bury_Animation = 1;0 is Disabled, 1 is enabled

RingOut_ResetWalls = 1;   Change to 0 to NOT have invisible walls recover between rounds

RingOut_LeftWall_Health = 50; Self Explanatory - set to zero to have no left wall, each wall hit removes 35
RingOut_LeftWall_Only_SelfState_Players = 0; Change to 1 to disable damage to wall if you are in CustomState
RingOut_LeftWall_Only_Knocked_Players = 1; Change to 1 to disable damage to wall unless Hitfall
RingOut_LeftWall_Only_Hit_Players = 1;     Change to 1 to disable damage to wall unless MoveType = H
RingOut_LeftWall_Only_NoCtrl_Players = 1;  Change to 1 to disable damage to wall unless Player has no CTRL
RingOut_LeftWall_Only_Fast_Players = 3;    Change to > 0 to disable damage to wall unless player has at least that speed
RingOut_LeftWall_Only_High_Players = -35;    Change to < 0 to disable damage to wall unless player is at least above that height

RingOut_RightWall_Health = 50; Self Explanatory - set to zero to have no right wall, each wall hit removes 35
RingOut_RightWall_Only_SelfState_Players = 0; Change to 1 to disable damage to wall if you are in CustomState
RingOut_RightWall_Only_Knocked_Players = 1; Change to 1 to disable damage to wall unless Hitfall
RingOut_RightWall_Only_Hit_Players = 1;     Change to 1 to disable damage to wall unless MoveType = H
RingOut_RightWall_Only_NoCtrl_Players = 1;  Change to 1 to disable damage to wall unless Player has no CTRL
RingOut_RightWall_Only_Fast_Players = 3;    Change to > 0 to disable damage to wall unless player has at least that speed
RingOut_RightWall_Only_High_Players = -35;    Change to < 0 to disable damage to wall unless player is at least above that height
;--------------------------------------------------------
[PlayerInfo]
;--- Player 1 ---
 ;Player 1 starting coordinates.
 ;p1startx is typically -70 and p2startx is 70.
 ;p1starty and p1startz should be 0.
p1startx = -150          ;Starting x coordinates
p1starty = 0          ;Starting y coordinates
p1startz = 0            ;Starting z coordinates
p1facing = 1            ;Direction player faces: 1=right, -1=left

;--- Player 2 ---
p2startx = 150
p2starty = 0
p2startz = 0
p2facing = -1

;--- Common ---
 ;Don't change these values.
leftbound  =  -1600 ;Left bound (x-movement)
rightbound =  1600 ;Right bound
topbound  =  0     ;Top bound (z-movement)
botbound  =  0     ;Bottom bound

;--------------------------------------------------------
[Scaling]
 ;No need to change these values
topz     = 0       ;Top z-coordinate for scaling
botz     = 50      ;Bottom z-coordinate for scaling
topscale = 1       ;Scale to use at top
botscale = 1.2     ;Scale to use at bottom

;--------------------------------------------------------
[Bound]
 ;Distance from left/right edge of screen that player can move to
 ;Typically 15
screenleft = 5    ;Dist from left of screen that player can move to
screenright = 5   ;Right edge

;--------------------------------------------------------
[StageInfo]
 ;Z offset for drawing
 ;Adjust this value to move the ground level up/down in the screen.
 ;It's the position where the players stand at.
 ;Up - smaller, Down - larger
 ;***
zoffset = 150

 ;Leave this at 1. It makes the players face each other
autoturn = 1

 ;Set the following to 1 to have the background be reset between
 ;rounds.
resetBG = 1

;--------------------------------------------------------
[Shadow]
 ;This is the shadow color given in r,g,b. Valid values for each
 ;range from 0 (lightest) to 255 (darkest).
 ;Defaults to 92,92,92 if omitted.
color = 0,0,0

 ;This is the scale factor of the shadow. Use a big scale factor
 ;to make the shadow longer. You can use a NEGATIVE scale factor
 ;to make the shadow fall INTO the screen.
 ;Defaults to 0.4 if omitted.
yscale = 1.5


 ;Set to 1 to draw "reflection" shadows. Defaults to 0.
reflect = 0

;--------------------------------------------------------
[Music]
 ;Put a filename for a MOD, MP3 or MIDI here, or just leave it
 ;blank if you don't want music. If an invalid filename is
 ;given, then no music will play. To play CD audio, put
 ;the track number followed by ".da". Using a track number of
 ;0 will play a random audio track. For example, to play
 ;track 3 from a music CD, use:
 ;  bgmusic = 3.da
bgmusic = sound/TitanFighting.mp3

 ;Adjust the volume. 0 is normal, negative for softer, and
 ;positive for louder (only for mp3, mods and CDA)
bgvolume = 255

;========================================================
;--------------------------------------------------------
; Background definition
; ***
;-------------------------------------
; [BG x]
; type = ?       "Normal"/"Parallax"/"Height"  (def: "normal")
; spriteno = ?, ? Sprite group and number: groupno, imgno  (req'd)
; start = ?, ?   Starting location (integer)  (def: 0, 0)
; delta = ?, ?   Change in location per camera unit moved (float)  (def: 1,1)
; trans = ?      Transparency settings: "none"/"add"/"sub"/"avg" (def: "none")
; mask = ?       Masking (int): 0 - off, 1 - on  (def: 0)
; velocity = ?, ? Velocity: x, y (float): speed background moves (def: 0, 0)
; tile = ?, ?    Tiling: xtile, ytile (int): 0 - off, 1 - infinite,
;                        >1 - tile that number of times  (def: 0, 0)
; tilespacing = ?, ? Tiling: x, y (int) : space between tiles (def: 0, 0)
;  Parallax-only:
; xscale = ?, ?    Top xscale, bottom xscale (float) (if used, then no tiling)
; width = ?, ?     Top width, bottom width (int)  (if used, then tiles;
;                             use either this or above, but not both)
; yscalestart = ?  Starting y-scale (float, in percent)  (def: 100)
; yscaledelta = ?  Change in y-scale per unit (float, in percent)  (def: 0)
;-------------------------------------

;-------------------------------------
; Main background definition
[BGdef]
 ;Filename of sprite data
spr = stages/TitanFighting.sff

 ;Set to 1 if you want to clear the screen to magenta before
 ;drawing layer 0 (the default background). Good for spotting "holes"
 ;in your background.
 ;Remember to turn this off when you are done debugging the background,
 ;because it slows down performance.
debugbg = 0

