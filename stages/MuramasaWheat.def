[Info]        
name = "Muramasa Wheat" 
displayname = "Muramasa Wheat" ;Name to display
versiondate = 09,30,2009    ; 8/1/2017 Version date of stage (MM,DD,YYYY or X.XX)
mugenversion = 1.0          ;Version of M.U.G.E.N stage works on (X.XX)
author = "Odb718"         ;Stage author name

[Camera]
startx         	= 0         
starty         	= 0  
boundleft 	= -1560
boundright 	= 1900            
boundhigh     	= 0   
boundlow       	= 10         
floortension 	= 120
verticalfollow	= .25
tension		= 100
zoomout 	= 0.8   
zoomin 		= 1.3

[PlayerInfo]       
p1startx       = -70        
p1starty       = 0         
p1startz       = 0           
p1facing       = 1              
p2startx       = 70         
p2starty       = 0         
p2startz       = 0           
p2facing       = -1    
leftbound  = -2400
rightbound =  2400             
topbound       = 0           
botbound       = 0           

[Scaling]
topz           = 0           
botz           = 50         
topscale       = 1           
botscale       = 1.2        

[Bound]
screenleft = 0
screenright = 0    

[StageInfo]
zoffset        = 208;190;221         
autoturn       = 1           
resetBG        = 1           
Hires          = 1
xscale = 0.5 ; Horizontal scaling factor of offsets, velocities, sprites and animations.
yscale = 0.52 ; Vertical scaling factor of offsets, velocities, sprites and animations. 

[Shadow]
color = 256,256,256                          
yscale = 0.2         
       
[Music]
bgmusic = sound/MuramasaWheat.mp3  ;Muramasa: The Demon Blade OST - Turbulent State  
bgvolume = 255 
 
