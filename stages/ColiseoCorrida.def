;                        EDITED STAGE
;=============================================================
;  STAGE INFORMATION :
;
;  Resolution : 1280 * 720
;  Mugen Version : Mugen 1.1 only
;  Versiondate : 2016
;  
;
;=============================================================
[Info]
Name = "ColiseoCorrida"
displayname = "Colosseum"
author = "Daniel's" 
mugenversion = 1.1
;AttachedChar= LasombraSystems\LasombraSystems.CHR
;--------------------------------------------------------
[camera]
startx = 0
starty = 0
boundleft =-380
boundright = 380
boundhigh=-380 
boundlow =0
verticalfollow = .70
floortension = 100
tension =190
tensionhigh = 160
tensionlow = 25
overdrawhigh = 100
overdrawlow = 100
cuthigh = 0
cutlow = 0
zoomin = 1.15
zoomout = .7

;--------------------------------------------------------
[CONSTANTS]
;++RING OUT SYSTEM SECTION+++ 
;para el amigo Gacel, lo prometido es deuda. 
;Gracias por todo el esfuerzo que has puesto al motor.

RingOut_Enable = 1;       Change to 0 to disable Ring Outs   
Left_Limit_RingOut = -541;You can also use debug to help yourself 
Right_Limit_RingOut = 541;to data required from P1

Show_Help_Arrows = 0;     Change to 1 to see bound limits

Only_SelfState_Players = 0; Change to 1 to disable RO if you are in CustomState
Only_Knocked_Players = 1; Change to 1 to disable RO unless Hitfall
Only_NoCtrl_Players = 1;  Change to 1 to disable RO unless Player has no CTRL
Only_Fast_Players = 1;    Change to > 0 to disable RO unless player has at least that speed
Only_High_Players = 0;    Change to < 0 to disable RO unless player is at least above that height

RingOut_Announcer = 1;    0 and 1 are SC, 2 is VF, 3 is Fatal Fury
RingOut_FX = 1;           0 is SC font, 1 is golden, 2 is Fatal Fury
RingOut_Falling = 1;	  Change to 0 to disable "player falling" effect
RingOut_Priority = 1;	  Change to 1 to make the "player falling" effect go on everything

Cheer_System_Enable = 1;0 is Disabled, ID 1 for the BGCtrl to be shown during the frantic moment

Bury_Edge_Limit = 180; Character is at least 180 pixels away from either Stage Edge
Bury_Animation = 1;0 is Disabled, 1 is enabled
;--------------------------------------------------------
[PlayerInfo]
;--- Player 1 ---
p1startx = -90          ;Starting x coordinates
p1starty = 0            ;Starting y coordinates
p1startz = 0            ;Starting z coordinates
p1facing = 1            ;Direction player faces: 1=right, -1=left

;--- Player 2 ---
p2startx = 90
p2starty = 0
p2startz = 0
p2facing = -1

;--- Player 3 ---
p3startx = -120
p3starty = 0
p3facing = 1

;--- Player 4 ---
p4startx =120
p4starty = 0
p4facing = -1

;--- Common ---
 ;Don't change these values.
leftbound = -4000
rightbound = 4000
topbound = 0
botbound = 0

;--------------------------------------------------------
[Bound]
screenleft = 25
screenright = 25

;--------------------------------------------------------
[StageInfo]
zoffset = 199
autoturn = 1
resetBG = 0;1
localcoord=384,216
hires = 1

;--------------------------------------------------------
[Shadow]
color = 26,26,26
yscale = .20

;--------------------------------------------------------
[Music]
bgmusic = sound/ColiseoCorrida.mp3
bgmvolume = 145

;================================================================================
;================================================================================
[bgdef]
spr =ColiseoCorrida.sff
debugbg = 0

