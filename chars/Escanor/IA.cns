trigger1 = command = "s"
trigger1 = command = "holddown"
var(9) = 1

[State 0, PowerAdd]
type = poweradd
triggerall = power < powermax
triggerall = RoundState = 2
trigger1 = stateno != [1000,3500]
triggerall = var(2) != 3
triggerall = var(2) < 5
triggerall = alive = 1
trigger1 = 1
value = 1
ignorehitpause = 1

;---------------------------------------------
; AWAKENING SYSTEM
;---------------------------------------------
[state > aura awakening fx]
type = helper
triggerall = (stateno != [3000, 4999]) && var(41)=1
trigger1 = !numhelper(30508)
stateno = 30508
id = 30508
ownpal = 1
postype = p1
size.mid.pos = (const(size.mid.pos.x) + 0), 0
size.head.pos = 0, (var(53))
size.xscale = .15
size.yscale = .2
supermovetime = 999
pausemovetime = 999

[state 0, Low Life]
type = palfx
triggerall = roundstate = 2
triggerall = alive
triggerall = life <= 300
trigger1 = time % (30 + (life / 50)) = 0
time = 40
add = 0, (-22 + floor(life / 15)), (-22 + floor(life / 15))
sinadd = 0, (-22 + floor(life / 15)), (-22 + floor(life / 15)), (-22 + floor(life / 15))
color = 200 + floor(life / 17.6)
ignorehitpause = 1

[State 0, Esconder Barra]
type = RemoveExplod
trigger1 = stateno = [3100,3110]
id = 30900
ignorehitpause = 1
