pos = 0,0
postype = p1
ownpal = 1
size.xscale = .20
size.yscale = .20
SuperMoveTime = 9999
PauseMoveTime = 9999

[State 0,AssertSpecial]
type = AssertSpecial
trigger1 = root,stateno = 3303
flag = Invisible

[State 0, RemoveExplod]
type = RemoveExplod
trigger1 = root,stateno = 5110
trigger2 = root,stateno = 3303 && root,time = [0,200]
trigger3 = root,stateno = 181 && root,time > 60
trigger4 = root,stateno = 1201 && root,time > 5
trigger5 = root,stateno = 1201 && root,time = [24,29]
id = 15563

[State 200, End]
type = Destroyself
trigger1 = time = -1
trigger2 = root,var(2) != 4
trigger3 = root,life = 0
