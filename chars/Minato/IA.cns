triggerall = var(41) = 1
trigger1 = var(40) >= 1000
stateno = 99005
id = 30105
pos = 0, -25
postype = p1
ownpal = 1
size.xscale = .1
size.yscale = .1
supermovetime = 999
pausemovetime = 999
persistent = 1
ignorehitpause = 1

;===============================================================================
; Awake Bar:
;-------------------------------------------------------------------------------
[State 0, Incrementar Barra (condicoes)]
type = VarAdd
triggerall = alive
triggerall = var(41) = 0
triggerall = stateno != [3100,3170] ;Impede aumentar no ULT
triggerall = stateno != 31044
trigger1 = StateNo = [150,152] ; IDs dos estados padrao de guarda
trigger2 = movetype = H ; Estado de sofrer dano
trigger3 = movehit || helper,movehit  ; Estados de causar dano
var(40) = 1          ; Adiciona ponto por frame
ignorehitpause = 1

[State 0, Incrementar Barra (charge)]
type = VarAdd
triggerall = alive
triggerall = var(41) = 0
triggerall = timemod = 3,0
trigger1 = StateNo = 500
var(40) = 3
ignorehitpause = 1

[State 0, Limite Maximo da Barra]
type = VarSet
trigger1 = var(40) > 1000
var(40) = 1000
ignorehitpause = 1

[State 0, Decrementar Barra]
type = VarAdd
triggerall = var(40) > 0
triggerall = var(41) = 1
triggerall = RoundState = 2
triggerall = alive = 1
trigger1 = (GameTime%2) = 0
var(40) = -1
ignorehitpause = 1

[State 0, Variavel de barra cheia]
type = VarSet
trigger1 = var(40) >= 1000
var(41) = 1
ignorehitpause = 1

[State 0, Variavel de barra vazia]
type = VarSet
trigger1 = var(40) <= 0
trigger2 = roundstate != 2
var(41) = 0
ignorehitpause = 1

[State 0, Impedir Barra Negativa]
type = VarSet
trigger1 = var(40) < 0
var(40) = 0
ignorehitpause = 1

[State -2, Remover Fundo da Barra]
type = RemoveExplod
triggerall = palno < 10
triggerall = roundstate != 2
trigger1 = numexplod(30900)
ID = 30900
ignorehitpause = 1
[State -2, Remover Fundo da Barra]
type = RemoveExplod
triggerall = palno < 10
triggerall = roundstate != 2
trigger1 = numexplod(30902)
ID = 30902
ignorehitpause = 1

; ===================================================
; HUD CUSTOMIZADO:(Transform Bar)
; ===================================================

; 1. CRONOMETRO DE VISIBILIDADE (Apenas no Charge)
[State -2, Ativar Timer de Visibilidade]
type = VarSet
trigger1 = stateno = 500
fvar(39) = 60
ignorehitpause = 1

[State -2, Reduzir Timer]
type = VarSet
trigger1 = fvar(39) > 0
fvar(39) = fvar(39) - 1
ignorehitpause = 1

; 2. CALCULAR ESCALA DO PREENCHIMENTO
[State -2, Calcular Escala (Decimal)]
type = VarSet
triggerall = palno < 10
trigger1 = 1
fvar(37) = (var(40) / 1000.0) * 0.1
ignorehitpause = 1

; 3. CRIAR A BARRA DE FUNDO
[State -2, Fundo da Barra]
type = Explod
triggerall = palno < 10
triggerall = roundstate = 2
triggerall = stateno != [3100,3170]
triggerall = stateno != 31044
trigger1 = !NumExplod(30900)
trigger1 = fvar(39) > 0 || var(40) >= 1000 || var(41) = 1
anim = 30900
id = 30900
pos = 0,5
postype = p1
facing = 1
bindtime = -1
removetime = -1
scale = .102, .12
sprpriority = 8
ownpal = 1
ignorehitpause = 1

; 4. CRIAR A BARRA DE PREENCHIMENTO
