;ignorehitpause = 1

[State 0, Change Movelist]
type = ChangeMovelist
trigger1 = var(2) = 0
value = 0
[State 0, Change Movelist]
type = ChangeMovelist
trigger1 = var(2) = 1
value = 1

[State 0, Change Character Name]
type = ModifyPlayer
trigger1 = var(2) = 0
displayname = "Minato"
[State 0, Change Character Name]
type = ModifyPlayer
trigger1 = var(2) = 1
displayname = "Minato -KCM-"

[State -2, PowerAdd]
type = poweradd
triggerall = RoundState = 2
triggerall = power < powermax
triggerall = stateno != [1000,3500]
triggerall = stateno != [30000,30500]
triggerall = alive = 1
trigger1 = 1
value = 1
ignorehitpause = 1

[State -2, EffectsColor]
type = RemapPal
trigger1 = var(2) = 0
source = 3,0
dest = 3,5
[State -2, EffectsColor]
type = RemapPal
trigger1 = var(2) = 1
source = 3,0
dest = 3,7
;===============================================================================
; Despertar (Awake)
;===============================================================================
[state > aura awakening fx]
type = helper
triggerall = var(2) != 2
triggerall = (stateno != [3000, 4999]) && var(41)=1
trigger1 = !numhelper(30508)
stateno = 30508
id = 30508
ownpal = 1
postype = p1
size.mid.pos = (const(size.mid.pos.x) + 0), 0
size.head.pos = 0, (var(53))
size.xscale = .15
size.yscale = .2
supermovetime = 999
pausemovetime = 999

[state 0, Low Life]
type = palfx
triggerall = roundstate = 2
triggerall = alive
triggerall = life <= 300
trigger1 = time % (30 + (life / 50)) = 0
time = 40
add = 0, (-22 + floor(life / 15)), (-22 + floor(life / 15))
sinadd = 0, (-22 + floor(life / 15)), (-22 + floor(life / 15)), (-22 + floor(life / 15))
color = 200 + floor(life / 17.6)
ignorehitpause = 1

[State 0, Esconder Barra]
type = RemoveExplod
trigger1 = stateno = [3100,3170]
trigger2 = stateno = 31044
id = 30900
ignorehitpause = 1
[State 0, Esconder Barra]
type = RemoveExplod
trigger1 = stateno = [3100,3170]
trigger2 = stateno = 31044
id = 30902
ignorehitpause = 1

;Repulso da Barra Cheia
[state 0]
type = helper
