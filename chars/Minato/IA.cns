; ===================================================
; 9. ATUALIZADORES VISUAIS (ModifyExplod) - Apenas para ID 30902
; ===================================================
[State -2, Atualizar Tamanho]
type = ModifyExplod
triggerall = palno < 10
triggerall = roundstate = 2
triggerall = NumExplod(30902)
trigger1 = var(40) < 1000
trigger1 = var(41) = 0
id = 30902
scale = fvar(37),.12
ignorehitpause = 1

[State -2, Atualizar Cheia Solida]
type = ModifyExplod
triggerall = NumExplod(30902)
triggerall = (GameTime % 16) < 8
trigger1 = var(40) >= 1000
trigger2 = var(41) = 1
id = 30902
scale = fvar(37),.12
trans = none
ignorehitpause = 1

[State -2, Atualizar Cheia Brilhando]
type = ModifyExplod
triggerall = NumExplod(30902)
triggerall = (GameTime % 16) >= 8
trigger1 = var(40) >= 1000
trigger2 = var(41) = 1
id = 30902
scale = fvar(37),.12
trans = add
ignorehitpause = 1
