;===============================================================================
; INTELIGENCIA ARTIFICIAL:
;===============================================================================
[Statedef -2]

;[State Test]
;type = MatchRestart
;trigger1 = life <= 400
;p1teammode = "tag"
;p1def = "chars/goku/gokubase.def"
;p2def = "chars/frieza/frieza.def"
;p3def = "chars/vegeta/vgeta.def"
;stagedef = "stages/stage0.def"
;reload = 0,1

;[State -2, RoundTimeSet]
;type = RoundTimeSet
;trigger1 = life <= 400
;triggerall = gamemode = "arc0"
;triggerall = enemy,Name="Frieza"
;value = 0

[State -2, PowerAdd Base]
type = poweradd
triggerall = power < powermax
triggerall = RoundState = 2
triggerall = stateno != [1000,3500]
triggerall = var(2) = 0
triggerall = alive = 1
trigger1 = gametime%2 = 0
value = 1
ignorehitpause = 1

[State -2, PowerAdd Base]
type = poweradd
triggerall = power < powermax
triggerall = RoundState = 2
triggerall = stateno != [1000,3500]
triggerall = var(2) = 1
triggerall = alive = 1
trigger1 = gametime%1 = 0
value = 1
ignorehitpause = 1

[State 0, Projectile]
type = Projectile
triggerall = NumTarget
trigger1 = target,alive
trigger1 = movehit 
trigger1 = cond((target,gethitvar(hittime)<0 && target,gethitvar(damage)),time = -1,timemod = 1,0)
trigger1 = hitdefattr = SCA,SA
ProjID = 8223
projanim = 10200
projhitanim = 10201
projremove = 1
projremovetime = -1
projhits = 0
projpriority = -4
projsprpriority = -6
projedgebound = 999999
ignorehitpause = 1
projstagebound = 999999
projheightbound = -240
offset =(target,pos x - pos x)*cond(facing=1,1,-1),fvar(13)
postype = p1   
projshadow = 0,0,0
supermovetime = 0
pausemovetime = 0
velocity = fvar(11),fvar(10)
accel = 0.002*-facing,cond(fvar(10)>0,0.90234 ,.35)
pausemovetime = 0
projscale = fvar(12),fvar(12)

			[State 0, Null]
			type = Null
			triggerall = Numtarget > 0
			trigger1 = (fvar(13):= ((target,pos y )-46+random%45))
			trigger1 = fvar(11):= 1.7+random%4
			trigger1 = fvar(10):= -5+random%6
			trigger1 = fvar(12):= 0.05+(var(55)*cond(random%2=1,0.05,0.05))
			ignorehitpause = 1


			[State 0, VarRandom]
			type = VarRandom
			trigger1 = 1
			v = 55
			range = 0,7
			ignorehitpause = 1
;===============================================================================
; BASICS
;===============================================================================

[State 0, Guard]
type = ChangeState
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = (p2bodydist x < 50 && p2movetype = A) || (enemy,numproj > 0)
trigger1 = random < (ailevel * 100)/2
value = ifelse(statetype = A,132,130)

[State 0, Jump]
type = ChangeState
triggerall = statetype != A
triggerall = ailevel > 0 && roundstate = 2
triggerall = p2bodydist x < 60
triggerall = p2bodydist y < -15
triggerall = ctrl
trigger1 = random < (ailevel * 100)/10
value = 40


[State 0, Run]
type = ChangeState
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x > 100
trigger1 = random < (ailevel * 100)/2
value = cond(pos y < 0, 110,60)

[State 0, Run Atras]
type = ChangeState
triggerall = backedgebodydist > 50
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x < 100 && p2movetype = A
trigger1 = random < (ailevel * 100)*2
value = cond(pos y < 0, 115,70)

[State 0, phantom mode Activar]
type = ChangeState
triggerall = statetype != A
triggerall = power >= 2000
Triggerall = var(2) = 0
triggerall = ctrl
triggerall = ailevel > 0 && roundstate = 2
trigger1 = random < (ailevel * 100)/3
value = 600

;=======================
;ATTACKS

[State 0, A]
type = ChangeState
triggerall = enemy,stateno != [5100,5150]
triggerall = statetype != A
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x < 25
triggerall = p2bodydist y > -40
trigger1 = random < (ailevel * 100)*2
value = 200
[State 0, Down + A]
type = ChangeState
triggerall = statetype != A
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x < 40
triggerall = p2bodydist y > -40
trigger1 = random < (ailevel * 100)
value = 230
[State 0, A air]
type = ChangeState
triggerall = statetype = A
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x < 50
triggerall = p2bodydist y = [-15,45]
trigger1 = random < (ailevel * 100)*2
value = 245


[State 0, B]
type = ChangeState
triggerall = enemy,stateno != [5100,5150]
triggerall = statetype != A
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x < 40
triggerall = p2bodydist y > -40
trigger1 = random < (ailevel * 100)
value = 300
[State 0, Down + B]
type = ChangeState
triggerall = statetype != A
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x < 60
triggerall = p2bodydist y > -40
trigger1 = random < (ailevel * 100)
value = 330
[State 0, B air]
type = ChangeState
triggerall = statetype = A
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x < 60
triggerall = p2bodydist y = [-40,30]
trigger1 = random < (ailevel * 100)*2
value = 345


[State 0, C]
type = ChangeState
triggerall = var(2) = 0
triggerall = power >= 500
triggerall = statetype != A
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x > 50
triggerall = p2bodydist y = [0,-60]
trigger1 = random < (ailevel * 100)/3
value = 400
[State 0, C phantom]
type = ChangeState
triggerall = var(2) = 1
triggerall = statetype != A
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x > 50
triggerall = p2bodydist y = [0,-60]
trigger1 = random < (ailevel * 100)*3
value = 605

[State 0, down C]
type = ChangeState
triggerall = var(2) = 0
triggerall = power >= 350
triggerall = statetype != A
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x < 50
triggerall = p2bodydist y = [0,-60]
trigger1 = random < (ailevel * 100)/cond(p2movetype = A,0,3)
value = 450

[State 0, C air]
type = ChangeState
triggerall = var(2) = 0
triggerall = power >= 350
triggerall = statetype = A
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x < 50
triggerall = p2bodydist y = [15,-15]
trigger1 = random < (ailevel * 100)/2
value = 445
;===============================================================================;
;COMMON STATES =================================================================;
;===============================================================================;
[Statedef -3]

;-----------------
; Change Pallete
[State 0, Change Pallete]
type = RemapPal
trigger1 = ailevel = 0
source = 1,1
dest = 1,var(35)
ignorehitpause = 1
;-----------------
[State 0, Null]
type = Null
triggerall = var(35) <= 0
trigger1 = var(35) := 1
ignorehitpause = 1


[State 0]
type = varadd
triggerall = ailevel = 0
triggerall = numhelper(750) = 0
triggerall = var(35) <  6
triggerall = roundstate < 2
trigger1 = ailevel  = 0 && command = "fwd" && teamside = 1
trigger2 = ailevel  = 0 && command = "back" && teamside = 2
var(35) = 1
[State 0]
type = varadd
triggerall = ailevel = 0
triggerall = numhelper(750) = 0
triggerall = var(35) >  1
triggerall = roundstate < 2
trigger1 = ailevel  = 0 && command = "back" && teamside = 1
trigger2 = ailevel  = 0 && command = "fwd" && teamside = 2
var(35) = -1
[State 0, EnvShake]
type = EnvShake
trigger1 = numhelper(750)
time = 10
ampl = -2
freq = 35


[State 0, Helper]
type = Helper
triggerall = ailevel = 0
triggerall = roundstate < 2
trigger1 = command = "back" ||command = "fwd"
helpertype = normal ;player
name = "change pal fx"
ID = 750
stateno = 750
pos = 0,0
postype = p1    ;p2,front,back,left,right
ownpal = 1
supermovetime = 999
pausemovetime = 999
ignorehitpause = 1

[State 0, HELPER ESCALA]
type = Helper
trigger1 = NUMHELPER(999999) = 0
helpertype = normal
name = "HELPER ESCALA"
ID = 999999
stateno = 999999
pos = 9999,9999
postype = P1
facing = 1
keyctrl = 0
ownpal = 1
supermovetime = 999999
pausemovetime = 999999

