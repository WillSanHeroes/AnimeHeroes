type    = A
movetype= I
physics = N
anim = 7030
sprpriority = 3
velset = -.5,0

[State 0, PalFXWiz]
type = PalFX
trigger1 = 1
time = 99999
add = 0,0,0
mul = 256,256,256
color = 0

[State 0, VarSet]
type = VarSet
trigger1 = Time=0;4
fv = 6
value = 0

[State 0, VarAdd]
type = VarAdd
trigger1 = Time = [1,4]
fv = 6
value = .1

[State 0, VarAdd]
type = VarAdd
trigger1 = Time >= 5
fv = 6
value = -.05

[State 0, AngleDraw]
