movetype= I
physics = N

; [GUIDELINES] ========================
; - 001: Blue Charge || (FG/SPR:3)
; =====================================

[State 0, ChangeAnim]
type = ChangeAnim
TriggerALL = IsHelper(001)
trigger1 = !Time
value = 7100
elem = 1
ignorehitpause = 1
[State 0, SprPriority]
type = SprPriority
TriggerALL = IsHelper(001)
trigger1 = !Time
value = 10
ignorehitpause = 1

[State 0, PalFXWiz]
type = PalFX
TriggerALL = IsHelper(001)
trigger1 = 1
time = 99999
add = -128,-64,0
mul = 512,512,512
color = 0
 
[State 0, VarSet]
type = VarSet
trigger1 = !Time
Fv = 0
value = 0
[State 0, VarAdd]
type = VarAdd
trigger1 = AnimElemTime(15)>=0
Fv = 0
value = 25

[State 0, AngleDraw]
type = AngleDraw
trigger1 = 1
scale = 1,1

[State 0, Trans]
type = Trans
trigger1 = 1
trans = addalpha
alpha = 256-ceil(FVAR(0)),256

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = Noshadow

[State 200, End]
type = Destroyself
trigger1 = AnimTime = 0
