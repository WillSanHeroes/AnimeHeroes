trigger1 = StateNo = 0
trigger2 = StateNo!=[200,260]
trigger2 = StateNo!=[300,360]
trigger2 = StateNo!=[400,460]
Fv = 34
value = 0

;Non-limited Triggers:
;trigger1 = (StateNo=[200,220])||StateNo=225||StateNo=230||StateNo=235||StateNo=240
;trigger2 = (StateNo=[300,320])||StateNo=325||StateNo=330||StateNo=335||StateNo=340


[State 200, Stand A1~5];Stand A
type = ChangeState
TRIGGERALL = FVAR(20)<3 ;Define número de ataques Stand-A que tiene el char
TriggerALL = AiLevel=0&&Command="a"&&Command!="holddown"||RoundState=2&&AiLevel>0&&Random<(AiLevel*100)*4
TriggerALL = StateType != A
TriggerALL = movecontact
trigger1 = (StateNo=200) || (StateNo=[205,220])
trigger2 = stateno = 370
value = Cond(FVar(20)<1,200,Cond(FVar(20)<2,205,Cond(FVar(20)<3,210,Cond(FVar(20)<4,215,220))))


[State 230, Down+A];Down+A
type = ChangeState
TriggerALL = AiLevel=0&&Command="holddown"&&Command="a"||RoundState=2&&AiLevel>0&&Random<(AiLevel*100)/6
TriggerALL = StateType != A
TriggerALL = MoveHit
trigger1 = (StateNo=[200,210]) && movecontact
trigger2 = (StateNo=[300,305]) && movecontact
trigger3 = stateno = 310 && animelemtime(19) >= 0 && movecontact
trigger4 = stateno = 330 && movecontact
trigger5 = stateno = 370
value = 230


