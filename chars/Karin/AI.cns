;===============================================================================
; INTELIGENCIA ARTIFICIAL:
;===============================================================================
[Statedef -2]

;[State 0, AwakeBarFill]
;type = VarSet
;trigger1 = command = "z"
;var(40) = 980
;ignorehitpause = 1

[State -2, PowerAdd Base]
type = poweradd
triggerall = power < powermax
triggerall = RoundState = 2
triggerall = stateno != [1000,3500]
triggerall = alive = 1
trigger1 = gametime%2 = 0
value = 1
ignorehitpause = 1

[State 0, Change Movelist]
type = ChangeMovelist
trigger1 = var(2) = 0
value = 0
[State 0, Change Movelist]
type = ChangeMovelist
trigger1 = var(2) = 1
value = 1

[State 0, Change Character Name]
type = ModifyPlayer
trigger1 = var(2) = 0
displayname = "Karin"
[State 0, Change Character Name]
type = ModifyPlayer
trigger1 = var(2) = 1
displayname = "Karin -Demon Fox God-"

[state > aura awakening fx]
type = helper
triggerall = (stateno != [3000, 4999]) && var(41)=1
trigger1 = !numhelper(30508)
stateno = 30508
id = 30508
ownpal = 1
postype = p1
size.mid.pos = (const(size.mid.pos.x) + 0), 0
size.head.pos = 0, (var(53))
size.xscale = .15
size.yscale = .2
supermovetime = 999
pausemovetime = 999

[State -2, Zerar Barra (Interrompido durante o Fatal)]
type = VarSet
triggerall = var(40) > 0        ; Só roda se tiver barra
trigger1 = prevstateno = 3000   ; Se o estado ANTES de apanhar era o Fatal
trigger1 = movetype = H         ; E ele está apanhando agora
var(40) = 0
ignorehitpause = 1

[state 0, Low Life]
type = palfx
triggerall = roundstate = 2
triggerall = alive
triggerall = life <= 300
trigger1 = time % (30 + (life / 50)) = 0
time = 40
add = 0, (-22 + floor(life / 15)), (-22 + floor(life / 15))
sinadd = 0, (-22 + floor(life / 15)), (-22 + floor(life / 15)), (-22 + floor(life / 15))
color = 200 + floor(life / 17.6)
ignorehitpause = 1


;Repulso da Barra Cheia
[state 0]
type = helper
triggerall = alive
triggerall = var(41) = 1
trigger1 = var(40) >= 1000
stateno = 99005
id = 30105
pos = 0, -25
postype = p1
ownpal = 1
size.xscale = .1
size.yscale = .1
supermovetime = 999
pausemovetime = 999
persistent = 1
ignorehitpause = 1

;===============================================================================
; Awake Bar:
;-------------------------------------------------------------------------------
[State 0, Incrementar Barra (condições)]
type = VarAdd
triggerall = alive
triggerall = var(41) = 0
triggerall = stateno != [3100,3202] ;Impede aumentar no ULT
triggerall = stateno != 4900 ;Impede aumentar no ULT transformado
trigger1 = StateNo = [150,152] ; IDs dos estados padrão de guarda
trigger2 = movetype = H ; Estado de sofrer dano
trigger3 = movehit || helper,movehit  ; Estados de causar dano
var(40) = 1          ; Adiciona ponto por frame
ignorehitpause = 1

[State 0, Incrementar Barra (charge)]
type = VarAdd
triggerall = alive
triggerall = var(41) = 0
triggerall = timemod = 3,0
trigger1 = StateNo = 500
var(40) = 3
ignorehitpause = 1

[State 0, Limite Máximo da Barra]
type = VarSet
trigger1 = var(40) > 1000
var(40) = 1000
ignorehitpause = 1

[State 0, Decrementar Barra]
type = VarAdd
triggerall = var(40) > 0
triggerall = var(41) = 1
triggerall = RoundState = 2
triggerall = alive = 1
trigger1 = (GameTime%2) = 0
var(40) = -1
ignorehitpause = 1

[State 0, Variavel de barra cheia]
type = VarSet
trigger1 = var(40) >= 1000       ; Só ativa se a barra estiver cheia
var(41) = 1
ignorehitpause = 1

[State 0, Variavel de barra vazia]
type = VarSet
trigger1 = var(40) <= 0       ; Só ativa se a barra estiver cheia
trigger2 = roundstate != 2
var(41) = 0
ignorehitpause = 1

[State 0, Impedir Barra Negativa]
type = VarSet
trigger1 = var(40) < 0
var(40) = 0
ignorehitpause = 1

[State -2, Remover Fundo da Barra]
type = RemoveExplod
triggerall = palno < 10
triggerall = roundstate != 2
trigger1 = numexplod(30900)
ID = 30900
ignorehitpause = 1
[State -2, Remover Fundo da Barra]
type = RemoveExplod
triggerall = palno < 10
triggerall = roundstate != 2
trigger1 = numexplod(30902)
ID = 30902
ignorehitpause = 1

; ===================================================
; HUD CUSTOMIZADO:(Transform Bar)
; ===================================================
; 1. LÓGICA DO CRONÔMETRO DE VISIBILIDADE (Apenas no Charge)
[State -2, Ativar Timer de Visibilidade]
type = VarSet
trigger1 = stateno = 500  
fvar(39) = 60                  
ignorehitpause = 1

[State -2, Reduzir Timer]
type = VarSet
trigger1 = fvar(39) > 0
fvar(39) = fvar(39) - 1         
ignorehitpause = 1

; 2. CALCULAR ESCALA DO PREENCHIMENTO
[State -2, Calcular Escala (Decimal)]
type = VarSet
triggerall = palno < 10
trigger1 = 1
fvar(37) = (var(40) / 1000.0) * 0.1 
ignorehitpause = 1

; 3. CRIAR A BARRA DE FUNDO 
[State -2, Fundo da Barra]
type = Explod
triggerall = palno < 10 
triggerall = roundstate = 2
triggerall = stateno != [3100,3202]
trigger1 = !NumExplod(30900) 
trigger1 = fvar(39) > 0 || var(40) >= 1000 || var(41) = 1
anim = 30900
id = 30900
pos = 0,5
postype = p1
facing = 1
bindtime = -1
removetime = -1
scale = 0.102, 0.12
sprpriority = 0            
ownpal = 1
ignorehitpause = 1

; 4. CRIAR A BARRA DE PREENCHIMENTO
[State -2, Preenchimento Dinâmico]
type = Explod
triggerall = palno < 10 
triggerall = roundstate = 2
triggerall = stateno != [3100,3202]
trigger1 = !NumExplod(30902) 
trigger1 = fvar(39) > 0 || var(40) >= 1000 || var(41) = 1
anim = 30902
id = 30902
pos = 0,5
postype = p1
facing = 1
bindtime = -1
removetime = -1
scale = 0, 0.12
sprpriority = 1            
ownpal = 1
ignorehitpause = 1

; 5. CRIAR EFEITO CHOQUE DA BARRA CHEIA
[State -2, Criar Choque]
type = Explod
triggerall = palno < 10
triggerall = roundstate = 2
triggerall = !NumExplod(30324)             ; Só cria se AINDA NÃO existir
trigger1 = var(40) >= 1000                ; Quando a barra estiver cheia
trigger2 = var(41) = 1                    ; Ou enquanto estiver ativada
anim = 30324
id = 30324
pos = 0,5
postype = p1
facing = 1
bindtime = -1
removetime = -1
scale = .22,.05                       ; Ajustado para enquadrar na barra
sprpriority = 10                          ; Fica à frente da barra
ownpal = 1
removeongethit = 0
ignorehitpause = 1
supermovetime = 999
pausemovetime = 999

; 6. REMOVER O FUNDO QUANDO OCIOSO
[State -2, Remover Fundo Ocioso]
type = RemoveExplod
trigger1 = fvar(39) <= 0       ; O timer de carregar acabou
trigger1 = var(40) < 1000      ; Não está cheia
trigger1 = var(41) = 0         ; E não está no estado transformado
id = 30900
ignorehitpause = 1

; 7. REMOVER PREENCHIMENTO QUANDO OCIOSO
[State -2, Remover Barra Ociosa]
type = RemoveExplod
trigger1 = fvar(39) <= 0       
trigger1 = var(40) < 1000     
trigger1 = var(41) = 0        
id = 30902
ignorehitpause = 1

; 8. REMOVER EFEITO CHOQUE
[State -2, Remover Barra Ociosa]
type = RemoveExplod
trigger1 = fvar(39) <= 0       
trigger1 = var(40) < 1000     
trigger1 = var(41) = 0        
id = 30324
ignorehitpause = 1

; ===================================================
; 9. ATUALIZADORES VISUAIS (ModifyExplod) - Apenas para ID 30902
; ===================================================
[State -2, Atualizar Tamanho]
type = ModifyExplod
triggerall = palno < 10
triggerall = roundstate = 2
triggerall = NumExplod(30902)
trigger1 = var(40) < 1000
trigger1 = var(41) = 0
id = 30902
scale = fvar(37), 0.12
ignorehitpause = 1

[State -2, Atualizar Cheia Solida]
type = ModifyExplod
triggerall = NumExplod(30902)
triggerall = (GameTime % 16) < 8
trigger1 = var(40) >= 1000
trigger2 = var(41) = 1
id = 30902
scale = fvar(37), 0.12
trans = none
ignorehitpause = 1

[State -2, Atualizar Cheia Brilhando]
type = ModifyExplod
triggerall = NumExplod(30902)
triggerall = (GameTime % 16) >= 8
trigger1 = var(40) >= 1000
trigger2 = var(41) = 1
id = 30902
scale = fvar(37), 0.12
trans = add
ignorehitpause = 1

;----------------------------------------------------------------------------------------------
[State 0, Projectile]
type = Projectile
triggerall = NumTarget
trigger1 = target,alive
trigger1 = movehit 
trigger1 = cond((target,gethitvar(hittime)<0 && target,gethitvar(damage)),time = -1,timemod = 1,0)
trigger1 = hitdefattr = SCA,SA
ProjID = 8223
projanim = 10200
projhitanim = 10201
projremove = 1
projremovetime = -1
projhits = 0
projpriority = -4
projsprpriority = -6
projedgebound = 999999
ignorehitpause = 1
projstagebound = 999999
projheightbound = -240
offset =(target,pos x - pos x)*cond(facing=1,1,-1),fvar(13)
postype = p1   
projshadow = 0,0,0
supermovetime = 0
pausemovetime = 0
velocity = fvar(11),fvar(10)
accel = 0.002*-facing,cond(fvar(10)>0,0.90234 ,.35)
pausemovetime = 0
projscale = fvar(12),fvar(12)

			[State 0, Null]
			type = Null
			triggerall = Numtarget > 0
			trigger1 = (fvar(13):= ((target,pos y )-46+random%45))
			trigger1 = fvar(11):= 1.7+random%4
			trigger1 = fvar(10):= -5+random%6
			trigger1 = fvar(12):= 0.05+(var(55)*cond(random%2=1,0.05,0.05))
			ignorehitpause = 1


			[State 0, VarRandom]
			type = VarRandom
			trigger1 = 1
			v = 55
			range = 0,7
			ignorehitpause = 1

;===============================================================================
; BASICS
;===============================================================================

[State 0, Guard]
type = ChangeState
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = (p2bodydist x < 50 && p2movetype = A) || (enemy,numproj > 0)
trigger1 = random < (ailevel * 100)/2
value = ifelse(statetype = A,132,130)

[State 0, Jump]
type = ChangeState
triggerall = statetype != A
triggerall = ailevel > 0 && roundstate = 2
triggerall = p2bodydist x < 60
triggerall = p2bodydist y < -15
triggerall = ctrl
trigger1 = random < (ailevel * 100)/10
value = 40

[State 0, Power Charge]
type = ChangeState
triggerall = statetype != A
Triggerall = var(41)=0 || var(41)=1 && power<powermax
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x > 100
trigger1 = random < (ailevel * 100)/4
value = 500

[State 0, Power Charge End]
type = ChangeState
triggerall = time >= 20
triggerall = stateno = 500
triggerall = ailevel > 0
trigger1 = (p2bodydist x < 130) || (enemy,numproj > 0)
trigger2 = var(41)=1 && power=powermax
trigger3 = random < (ailevel * 100)/2 && enemy,stateno = [1000,1500]
trigger4 = random < (ailevel * 100)/2 && enemy,stateno = [25000,25500]
trigger5 = random < (ailevel * 100)/2 && enemy,stateno = [32000,32500]
trigger6 = random < (ailevel * 100)/2 && enemy,stateno = [34000,34500]
trigger7 = random < (ailevel * 100)/2 && enemy,stateno = [35000,35500]
trigger8 = random < (ailevel * 100)/2 && enemy,stateno = [36000,36500]
value = 505


[State 0, Run]
type = ChangeState
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x > 100
trigger1 = random < (ailevel * 100)/2
value = cond(pos y < 0, 110,60)

[State 0, Run Atras]
type = ChangeState
triggerall = backedgebodydist > 50
triggerall = ailevel > 0 && roundstate = 2
triggerall = ctrl
triggerall = p2bodydist x < 100 && p2movetype = A
trigger1 = random < (ailevel * 100)*2
value = cond(pos y < 0, 115,70)

[State 0, phantom mode Activar]
type = ChangeState
triggerall = statetype != A
triggerall = var(41) = 1
Triggerall = var(2) = 0
triggerall = ctrl
triggerall = ailevel > 0 && roundstate = 2
trigger1 = random < (ailevel * 100)/3
value = 600

