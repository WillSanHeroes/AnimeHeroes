;===============================================================================
; Gudodama:
;-------------------------------------------------------------------------------
[Statedef 1]
type    = A
movetype= I
physics = N
anim = 2
sprpriority = -1

[State 0, FX]
type = Explod
trigger1 = numexplod(3) = 0
anim = 3
ID = 3
pos = 0*Helper(999999),Fvar(16),0*Helper(999999),Fvar(16)
postype = p1
Bindtime = -1
sprpriority = -1
ontop = 0
ownpal = 1
Removetime = -1
Trans = Add

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = numhelper(2450) = 1
trigger2 = root,stateno = [39000,4000]
flag = Invisible

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = Noshadow

[State 0, BindToRoot] ; Normal
type = BindToRoot
trigger1 = 1
pos = -4*Helper(999999),Fvar(16),-40*Helper(999999),Fvar(16)

[State 0, BindToRoot] ; Crouch // Run
type = BindToRoot
trigger1 = root,stateno = [10,12]
trigger2 = root,stateno = [60,70]
pos = -4*Helper(999999),Fvar(16),-30*Helper(999999),Fvar(16)

[State 0, BindToRoot] ; Win
type = BindToRoot
trigger1 = root,stateno = 181
pos = -2*Helper(999999),Fvar(16),-40*Helper(999999),Fvar(16)

[State 0, BindToRoot] ; 2210
type = BindToRoot
trigger1 = root,stateno = 210
pos = -10*Helper(999999),Fvar(16),-40*Helper(999999),Fvar(16)

[State 0, BindToRoot] ; 2300
type = BindToRoot
trigger1 = root,stateno = 300
pos = 2*Helper(999999),Fvar(16),-35*Helper(999999),Fvar(16)

[State 0, BindToRoot] ; 2310
type = BindToRoot
trigger1 = root,stateno = 310
pos = -12*Helper(999999),Fvar(16),-40*Helper(999999),Fvar(16)

[State 0, BindToRoot] ; 2610
type = BindToRoot
trigger1 = root,stateno = 610
pos = -4*Helper(999999),Fvar(16),-32*Helper(999999),Fvar(16)


[State 0, VarSet] ; Alante
type = VarSet
trigger1 = root,stateno = 200 && root,time >= 5
trigger2 = root,stateno = 300 && root,time >= 5
trigger2 = root,stateno = 600 && root,time >= 3
v = 1
value = 1

[State 0, VarSet] ; Atras
type = VarSet
trigger1 = root,stateno != 22
trigger1 = root,stateno != 300
trigger1 = root,stateno != 610
v = 1
value = 0

[State 0, SprPriority]
type = SprPriority
trigger1 = var(1) = 1
value = 4

[State 0, SprPriority]
type = SprPriority
trigger1 = var(1) = 0
value = -1

[State 0, ModifyExplod]
type = ModifyExplod
trigger1 = var(1) = 1
Id = 3
sprpriority = 3
Trans = add
scale = 1*Helper(999999),Fvar(16),1*Helper(999999),Fvar(16)

[State 0, ModifyExplod]
type = ModifyExplod
trigger1 = var(1) = 0
Id = 3
sprpriority = -1
Trans = add
scale = 1*Helper(999999),Fvar(16),1*Helper(999999),Fvar(16)

[State 0, ModifyExplod]
type = ModifyExplod
trigger1 = var(1) = 1
Id = 4
sprpriority = 3
Trans = Sub
scale = 1*Helper(999999),Fvar(16),1*Helper(999999),Fvar(16)

[State 0, ModifyExplod]
type = ModifyExplod
trigger1 = var(1) = 0
Id = 4
sprpriority = -1
Trans = Sub
scale = 1*Helper(999999),Fvar(16),1*Helper(999999),Fvar(16)

[State 0, ModifyExplod]
type = ModifyExplod
trigger1 = root,stateno = 170 && root,time >= 5
ID = 3
scale = 0,0

[State 0, ModifyExplod]
type = ModifyExplod
trigger1 = root,stateno = 170 && root,time >= 5
ID = 4
scale = 0,0

[State 0, RemoveExplod]
type = RemoveExplod
trigger1 = root,var(4) != 1
trigger2 = numhelper(2450) = 1
id = 3

[State 0, RemoveExplod]
type = RemoveExplod
trigger1 = root,var(4) != 1
trigger2 = numhelper(2450) = 1
id = 4

[State 200, End]
type = Destroyself
trigger1 = root,var(4) != 1
trigger2 = numhelper(30350) = 1
trigger4 = numhelper(2450) = 1
