;===============================================================================
; SUSANOO:
;-------------------------------------------------------------------------------
; SUSANOO - Transform
[Statedef 35000]
type    = S
movetype= I
physics = S
juggle  = 1
velset = 0,0
ctrl = 0
anim = 35000
poweradd = -1000
sprpriority = 2

[State 0]
Type=Zoom
triggerall =teammode!=simul
Trigger1=Time=[0,10]
Scale=1+(Time * 0.05)
Pos=(Pos X/(1+(Time * 0.05)))* CameraZoom,0
IgnoreHitPause=1

[State 0]
Type=Zoom
triggerall =teammode!=simul
Trigger1=Time=[10,120]
Scale=1.5
Pos=(Pos X/2)* CameraZoom,0
IgnoreHitPause=1

[State 0, PlaySnd]
type = PlaySnd
trigger1 = time = 30
value = S5,50
volume = 999

[State 0, PlaySnd]
type = PlaySnd
trigger1 = time = 0
value = S0,39
volume = 999
[State 0, PlaySnd]
type = PlaySnd
trigger1 = time = 0
value = S0,39
volume = 999

[State 3000, SuperPause]
type = SuperPause
trigger1 = time = 0
time = 60
movetime = 60
anim = -1
sound = -1
pos = 999,999
darken = 0
unhittable = 1

[State 3000, VarSet]
type = Varset
trigger1 = time = 0
v = 12
value = -100

[State 3000, VarSet]
type = Varset
trigger1 = time = 60
v = 12
value = 0

[State 3000, VarAdd]
type = VarAdd
trigger1 = time >= 50 && Var(12) < 0
v = 12
value = 6

[State 3000, BGColorFX]
type = BGPalFX
trigger1 = Time > 0
time = 1
add = Var(12),Var(12),Var(12)

[State 0, Susanoo]
type = Helper
trigger1 = time = 30
helpertype = normal
name = "Susanoo"
ID = 36000
stateno = 36000
pos = 0,0
postype = p1
facing = 1
ownpal = 1
supermovetime = 30
supermove = 30
;Size.xscale = 1.1
;Size.yscale = 1.1

[State 0, PlaySnd]
type = PlaySnd
trigger1 = time = 30
value = S4,45
volume = 50

[State 0, EnvShake]
type = EnvShake
trigger1 = time = 30
time = 20

[State 200, End]
type = ChangeState
trigger1 = time = 60
value = 35001
;-------------------------------------------------------------------------------
; Susanoo - Stance
[Statedef 35001]
type    = S
movetype= I
physics = S
juggle  = 1
velset = 0,0
ctrl = 0
anim = 35010
sprpriority = 0

[State 0, Helper Tiempo]
type = Helper
trigger1 = prevstateno = 35000 && time = 0
helpertype = normal
name = "Helper Tiempo"
ID = 35100
stateno = 35100
pos = 0,0
postype = p1

[State 0, Turn]
type = Turn
trigger1 = p2bodydist x < -30

[State 0, WALK FWD]
type = ChangeState
trigger1 = ailevel = 0 && command = "holdfwd"
trigger2 = ailevel = 0 && command = "FF"
trigger3 = ailevel > 0 && random < (ailevel * 100)/4 && p2bodydist x > 75
value = 35020

[State 0, WALK BACK]
type = ChangeState
trigger1 = ailevel = 0 && command = "holdback"
trigger2 = ailevel = 0 && command = "BB"
trigger3 = ailevel > 0 && random < (ailevel * 100)/8 && p2bodydist x <= 75
value = 35021

[State 0, SUSANOO A]
type = ChangeState
trigger1 = ailevel = 0 && command != "holddown" && command = "a"
trigger2 = ailevel > 0 && random < (ailevel * 100) && p2bodydist x < 75
trigger2 = p2bodydist y < -50
value = 35200

[State 0, SUSANOO B]
type = ChangeState
trigger1 = ailevel = 0 && command != "holddown" && command = "b"
trigger2 = ailevel > 0 && random < (ailevel * 100) && p2bodydist x < 75
value = 35300

[State 0, SUSANOO C]
type = ChangeState
triggerall = power >= 600
trigger1 = ailevel = 0 && command != "holddown" && command = "c"
trigger2 = ailevel > 0 && random < (ailevel * 100)/4 && p2bodydist x > 100
value = 35400

[State 0, shinra tensei]
type = ChangeState
triggerall = power >= 1000
trigger1 = ailevel = 0 && command = "holddown" && command = "a"
trigger2 = ailevel > 0 && random < (ailevel * 100) && p2bodydist x = [150,250]
value = 35700

[State 0, Kirin]
type = ChangeState
triggerall = power >= 1000
trigger1 = ailevel = 0 && command = "holddown" && command = "b"
trigger2 = ailevel > 0 && random < (ailevel * 100) && p2bodydist x = [150,250]
value = 35800

[State 0, Kirin]
type = ChangeState
triggerall = power >= 1500
trigger1 = ailevel = 0 && command = "holddown" && command = "c"
trigger2 = ailevel > 0 && random < (ailevel * 100) && p2bodydist x = [150,250]
value = 35900

[State 200, End]
type = ChangeState
trigger1 = numhelper(35100) = 0 || roundstate != 2
trigger2 = ailevel = 0 && command = "holddown" && command = "s"
value = 35999


[State 200, End]
type = ChangeState
trigger1 = !alive
value = 5050
