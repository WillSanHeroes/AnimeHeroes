[State 0, Esconder Barra]
type = RemoveExplod
trigger1 = stateno = [3200,3202]
id = 30324
ignorehitpause = 1

;Repulso da Barra Cheia
[state 0]
type = helper
triggerall = alive
triggerall = var(41) = 1
trigger1 = var(40) >= 1000
stateno = 99005
id = 99005
pos = 0, -25
postype = p1
ownpal = 1
size.xscale = .1
size.yscale = .1
supermovetime = 999
pausemovetime = 999
persistent = 1
ignorehitpause = 1

; Power Up, AGI
[State -2, Agi Up]
type = Explod
triggerall = numhelper(99005)=1
trigger1 = !NumExplod(32009)
anim = 32009
id = 32009
pos = 35,-70
postype = p1
facing = facing
bindtime = -1
removetime = 75
scale = .05,.05
sprpriority = 8
ownpal = 1
ignorehitpause = 1

[State 0, Esconder Barra]
type = RemoveExplod 
trigger1 = numhelper(99005)=1
id = 30900
ignorehitpause = 1
[State 0, Esconder Barra]
type = RemoveExplod
trigger1 = numhelper(99005)=1
id = 30902
ignorehitpause = 1
[State 0, Esconder Barra]
type = RemoveExplod
