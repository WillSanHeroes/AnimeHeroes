;===============================================================================
; INTELIGENCIA ARTIFICIAL:
;===============================================================================
[Statedef -2]

[State 0, AwakeBarFill]
type = VarSet
trigger1 = command = "z"
var(40) = 980
ignorehitpause = 1
[State 0, AwakeBarFill]
type = VarSet
trigger1 = command = "x"
var(40) = 50
ignorehitpause = 1

[State -2, EffectsColor]
type = RemapPal
trigger1 = var(41) = 1
source = 3,0
dest = 3,12

[State -2, EffectsColor]
type = RemapPal
trigger1 = var(41) = 0
source = 3,0
dest = 3,10

[State -2, EffectsColor]
type = RemapPal
trigger1 = var(41) = 1
source = 1,1
dest = 2,1

[State -2, EffectsColor]
type = RemapPal
trigger1 = var(41) = 0
source = 1,1
dest = 1,palno

[State -2, PowerAdd Base]
type = poweradd
triggerall = power < powermax
triggerall = RoundState = 2
triggerall = stateno != [1000,3500]
triggerall = alive = 1
trigger1 = 1
value = 1
ignorehitpause = 1

[State -2,VarSet]
type = poweradd
triggerall = palno = 10
trigger1 = roundstate = 2
trigger1 = 1
value = 4

[state > aura awakening fx]
type = helper
triggerall = (stateno != [3000, 4999]) && var(41)=1
trigger1 = !numhelper(30508)
stateno = 30508
id = 30508
ownpal = 1
postype = p1
size.mid.pos = (const(size.mid.pos.x) + 0), 0
size.head.pos = 0, (var(53))
size.xscale = .15
size.yscale = .2
supermovetime = 999
pausemovetime = 999

[state 0, Low Life]
type = palfx
triggerall = roundstate = 2
triggerall = alive
triggerall = life <= 300
trigger1 = time % (30 + (life / 50)) = 0
time = 40
add = 0, (-22 + floor(life / 15)), (-22 + floor(life / 15))
sinadd = 0, (-22 + floor(life / 15)), (-22 + floor(life / 15)), (-22 + floor(life / 15))
color = 200 + floor(life / 17.6)
ignorehitpause = 1

[State 0, Esconder Barra]
type = RemoveExplod
trigger1 = stateno = [2998,3110]
id = 30900
ignorehitpause = 1
