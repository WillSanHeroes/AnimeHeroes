;---------------------------------------------------------------------------
; CGUARDHIT (shaking)
[Statedef 152]
type    = C
movetype= H
physics = N
velset = 0,0

[State 152, 1]
type = ChangeAnim
trigger1 = 1
value = 151

[State 152, 3]
type = ChangeState
trigger1 = HitShakeOver
value = 151 + 2*(command = "holddown")

[State 152, Hi to Lo]
type = StateTypeSet
triggerall = statetype = S
Trigger1 = var(59) = 0
Trigger1 = command = "holddown"
Trigger2 = var(59) != 0
Trigger2 = enemynear(var(57)),StateType!=A && fvar(30)=0
Trigger2 = Random <= var(58)*20||var(58)>9
statetype = C
physics = C

[State 152, Lo to Hi]
type = StateTypeSet
triggerall = statetype = C
Trigger1 = var(59) = 0
Trigger1 = command != "holddown"
Trigger2 = var(59) != 0
Trigger2 = enemynear(var(57)),StateType=A || fvar(30)=1
Trigger2 = Random <= var(58)*20||var(58)>9
statetype = S
physics = S

[State 3000, 1]
type = Explod
triggerall = !NumExplod(31101)
trigger1 = var(32) = 1
ID = 31101
anim = 31101
postype = P1
pos = 10,-40
ownpal = 1
bindtime = -1
sprpriority = 8
removetime = 20
scale = 1.3,1.3

[State -2]
type = PlaySnd
trigger1 = NumExplod(31101)
trigger1 = time = 0
value = 10, 0

[State -2, life]
type = Lifeset
trigger1 = NumExplod(31101)
value = var(31)

[State 152, 4]
type = ForceFeedback
trigger1 = time = 0
waveform = square
time = 4

