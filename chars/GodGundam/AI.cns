;===============================================================================
; Awake Bar:
;-------------------------------------------------------------------------------
[State 0, Incrementar Barra (condiÁıes)]
type = VarAdd
triggerall = alive
triggerall = var(41) = 0
triggerall = stateno != [3100,3202] ;Impede aumentar no ULT
triggerall = stateno != 4900 ;Impede aumentar no ULT transformado
trigger1 = StateNo = [150,152] ; IDs dos estados padr„o de guarda
trigger2 = movetype = H ; Estado de sofrer dano
trigger3 = movehit || helper,movehit  ; Estados de causar dano
var(40) = 1          ; Adiciona ponto por frame
ignorehitpause = 1

[State 0, Incrementar Barra (charge)]
type = VarAdd
triggerall = alive
triggerall = var(41) = 0
triggerall = timemod = 3,0
trigger1 = StateNo = 500
var(40) = 3
ignorehitpause = 1

[State 0, Limite M·ximo da Barra]
type = VarSet
trigger1 = var(40) > 1000
var(40) = 1000
ignorehitpause = 1

[State 0, Decrementar Barra]
type = VarAdd
triggerall = var(40) > 0
triggerall = var(41) = 1
triggerall = stateno != [3050,3099]
triggerall = RoundState = 2
triggerall = alive = 1
trigger1 = (GameTime%2) = 0
var(40) = -1
ignorehitpause = 1

[State 0, Variavel de barra cheia]
type = VarSet
trigger1 = var(40) >= 1000       ; SÛ ativa se a barra estiver cheia
var(41) = 1
ignorehitpause = 1

[State 0, Variavel de barra vazia]
type = VarSet
trigger1 = var(40) <= 0       ; SÛ ativa se a barra estiver cheia
trigger2 = roundstate != 2
var(41) = 0
ignorehitpause = 1

[State 0, Impedir Barra Negativa]
type = VarSet
trigger1 = var(40) < 0
var(40) = 0
ignorehitpause = 1

[State -2, Remover Fundo da Barra]
type = RemoveExplod
triggerall = palno < 10
triggerall = roundstate != 2
trigger1 = numexplod(30900)
ID = 30900
ignorehitpause = 1
[State -2, Remover Fundo da Barra]
type = RemoveExplod
triggerall = palno < 10
triggerall = roundstate != 2
trigger1 = numexplod(30902)
ID = 30902
ignorehitpause = 1

; ===================================================
; HUD CUSTOMIZADO:(Transform Bar)
; ===================================================

; 1. L”GICA DO CRON‘METRO DE VISIBILIDADE (Apenas no Charge)
[State -2, Ativar Timer de Visibilidade]
type = VarSet
trigger1 = stateno = 500  
fvar(38) = 60                  
ignorehitpause = 1

[State -2, Reduzir Timer]
type = VarSet
trigger1 = fvar(38) > 0
fvar(38) = fvar(38) - 1         
ignorehitpause = 1

; 2. CALCULAR ESCALA DO PREENCHIMENTO
[State -2, Calcular Escala (Decimal)]
type = VarSet
triggerall = palno < 10
trigger1 = 1
fvar(37) = (var(40) / 1000.0) * 0.1 
ignorehitpause = 1

; 3. CRIAR A BARRA DE FUNDO 
[State -2, Fundo da Barra]
type = Explod
triggerall = palno < 10 
triggerall = roundstate = 2
triggerall = stateno != [3100,3202]
trigger1 = !NumExplod(30900) 
trigger1 = fvar(38) > 0 || var(40) >= 1000 || var(41) = 1
anim = 30900
id = 30900
pos = 0,5
postype = p1
facing = 1
bindtime = -1
removetime = -1
scale = .102, .12
sprpriority = 8
ownpal = 1
ignorehitpause = 1

; 4. CRIAR A BARRA DE PREENCHIMENTO
[State -2, Preenchimento Dinamico]
type = Explod
triggerall = palno < 10 
triggerall = roundstate = 2
triggerall = stateno != [3100,3202]
trigger1 = !NumExplod(30902) 
trigger1 = fvar(38) > 0 || var(40) >= 1000 || var(41) = 1
anim = 30902
id = 30902
pos = 0,5
postype = p1
facing = 1
bindtime = -1
removetime = -1
scale = 0, .12
sprpriority = 9           
ownpal = 1
ignorehitpause = 1

; 5. CRIAR EFEITO CHOQUE
[State -2, Choque]
type = Explod
triggerall = palno < 10
triggerall = roundstate = 2
triggerall = !NumExplod(30324)             ; SÛ cria se AINDA N√O existir
trigger1 = var(40) >= 1000                ; Quando a barra estiver cheia
trigger2 = var(41) = 1                    ; Ou enquanto estiver ativada
anim = 30324
id = 30324
pos = 0,5
postype = p1
facing = 1
bindtime = -1
removetime = -1
scale = .2,.05                       ; Ajustado para enquadrar na barra
sprpriority = 10                          ; Fica ‡ frente da barra
ownpal = 1
removeongethit = 0
ignorehitpause = 1
supermovetime = 999
pausemovetime = 999

; 6. REMOVER O FUNDO QUANDO OCIOSO
[State -2, Remover Fundo Ocioso]
type = RemoveExplod
trigger1 = fvar(38) <= 0       ; O timer de carregar acabou
trigger1 = var(40) < 1000      ; N„o est· cheia
trigger1 = var(41) = 0         ; E n„o est· no estado transformado
id = 30900
ignorehitpause = 1

; 7. REMOVER PREENCHIMENTO QUANDO OCIOSO
[State -2, Remover Barra Ociosa]
type = RemoveExplod
trigger1 = fvar(38) <= 0       
trigger1 = var(40) < 1000     
trigger1 = var(41) = 0        
id = 30902
ignorehitpause = 1

; 8. REMOVER EFEITO CHOQUE
[State -2, Remover Barra Ociosa]
type = RemoveExplod
trigger1 = fvar(38) <= 0       
trigger1 = var(40) < 1000     
trigger1 = var(41) = 0        
id = 30324
ignorehitpause = 1

; ===================================================
; 9. ATUALIZADORES VISUAIS (ModifyExplod) - Apenas para ID 30902
; ===================================================
[State -2, Atualizar Tamanho]
type = ModifyExplod
triggerall = palno < 10
triggerall = roundstate = 2
triggerall = NumExplod(30902)
trigger1 = var(40) < 1000
trigger1 = var(41) = 0
id = 30902
scale = fvar(37),.12
ignorehitpause = 1

[State -2, Atualizar Cheia Solida]
type = ModifyExplod
triggerall = NumExplod(30902)
triggerall = (GameTime % 16) < 8
trigger1 = var(40) >= 1000
trigger2 = var(41) = 1
id = 30902
scale = fvar(37),.12
trans = none
ignorehitpause = 1

[State -2, Atualizar Cheia Brilhando]
type = ModifyExplod
triggerall = NumExplod(30902)
triggerall = (GameTime % 16) >= 8
trigger1 = var(40) >= 1000
trigger2 = var(41) = 1
id = 30902
scale = fvar(37),.12
trans = add
ignorehitpause = 1
