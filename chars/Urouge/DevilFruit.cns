;SPECIALS: DEVIL FRUIT
;===========================================================================
[State -1, SPECIAL 2]
type = ChangeState
Triggerall = power >= 1000
triggerall = var(2) = 1
value = 1130
trigger1 = command = "a"
[State -1, SPECIAL 3]
type = ChangeState
Triggerall = power >= 1500
triggerall = var(2) = 1
value = 1110
trigger1 = command = "b"
[State -1, SPECIAL 4]
type = ChangeState
Triggerall = power >= 1500
triggerall = var(2) = 1
value = 1120
trigger1 = command = "c"
[State -1, SUPER]
type = ChangeState
Triggerall = power >= 2000
triggerall = var(41) = 1
triggerall = var(2) = 1
value = 1300
trigger1= command = "y"
[State -1, SPECIAL 3]
type = ChangeState
Triggerall = power >= 2000
triggerall = var(41) = 0
triggerall = var(2) = 1
value = 4110
trigger1 = command = "y"
[State -1, SUPER]
type = ChangeState
Triggerall = power >= powermax
triggerall = teammode != simul
triggerall = var(41) = 1
triggerall = var(2) = 1
value = 4900
trigger1 = command = "z"

[State 200, End]
type = ChangeState
Triggerall = ailevel = 0
triggerall = time >= 12
trigger1 = command != "hold_s"
trigger2 = var(41)=1 && power=powermax
value = 2501
