value = S1,18
volume = 999
[State 0, PlaySnd]
type = PlaySnd
trigger1 = time = 0
value = S1,18
volume = 999

[State 200, 0]
type = changestate
trigger1 = root, stateno != 500
value = 345
;-------------------------------------------------------------------------------
; The World Fin
[Statedef 345]
type    = A
movetype= I
physics = N
juggle  = 1
velset = rootdist x / 10,0

[State 0, Trans]
type = Trans
trigger1 = 1
trans = add
alpha = 256-time*25,0+time*100

[State 200, End]
type = Destroyself
trigger1 = time >= 10
trigger2 = root,movetype = H
