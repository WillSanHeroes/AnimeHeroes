type    = S
movetype= I
physics = S
juggle  = 1
velset = 0,0
ctrl = 0
anim = 500
sprpriority = 2

;Aura Charge
[state 0]
type = helper
trigger1 = time = 10
stateno = 30500
id = 30500
postype = p1
ownpal = 1
supermovetime = 999
pausemovetime = 999
size.xscale = .9
size.yscale = .8
persistent = 0

;Reflexo
[state 0]
type = helper
trigger1 = (numhelper(6540) <= 5) && (time >= 15) && (time % 5 = 0)
stateno = 6540
id = 6540
pos = 0, 0
postype = p1
ownpal = 1
supermovetime = 999
pausemovetime = 999

;Vento
[State 0]
type = Explod
triggerall = time >= 10
trigger1 = timemod = 15,0
anim = 30513
pos = 0,0
postype = p1
bindtime = 1
removetime = -2
scale = .5,.5
sprpriority = 5
ownpal = 1
remappal = 3,0

;Esticar Char no começo
[state 0]
type = angledraw
trigger1 = time <= 20
scale = .95, 1.05 - (sin((time/ 50.0) * (pi / 2)) * 0.0125)
value = 0
ignorehitpause = 1

[State 0, PowerAdd]
type = PowerAdd
triggerall = time >= 7
trigger1 = 1
value = 10

[State 0, VarSet]
type = VarSet
trigger1 = time = 1
fv = 1
value = 0+random%2

;=====================================
;SPECIALS:
;=====================================
[State -1, Haki Attack]
type = ChangeState
Triggerall = power >= 1000
triggerall = var(2) = 0
value = 1008
trigger1 = command = "a"
[State -1, Spin]
type = ChangeState
Triggerall = power >= 1500
triggerall = var(2) = 0
value = 1010
trigger1 = command = "b"
[State -1, Haoshoku Haki]
type = ChangeState
triggerall = numhelper(22022) = 0
Triggerall = power >= 1500
triggerall = var(2) = 0
value = 1400
trigger1 = command = "c"
[State -1, Ground Explod]
type = ChangeState
Triggerall = power >= 2000
triggerall = var(2) = 0
value = 1011
trigger1 = command = "y"
[State -1, Awakenning]
type = ChangeState
triggerall = var(41) = 1
triggerall = var(2) = 0
value = 700
trigger1 = command = "x"
[State -1, ULT]
type = ChangeState
Triggerall = power >= powermax
triggerall = teammode != simul
triggerall = var(41) = 1
triggerall = var(2) = 0
value = 3000
trigger1 = command = "z"

[State 200, End]
type = ChangeState
Triggerall = ailevel = 0
triggerall = time >= 12
trigger1 = command != "hold_s"
trigger2 = var(41)=1 && power=powermax
value = 501
