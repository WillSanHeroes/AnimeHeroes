; GUARD (start)
[Statedef 192]
type = S
ctrl = 0
anim = BLST191
velset = 0,0
sprpriority = 2

[State 0, PalFXWiz]
type = PalFX
trigger1 = time = 0
time = 14
add = 180-time*30,180-time*30,180-time*30
mul = 256,256,256
sinadd = 0,0,0,1
color = 256

[State 0, AngleDraw]
type = AngleDraw
trigger1 = time < 20
scale = 0.1+time*.05,0.1+time*.05
ignorehitpause = 10


[State 0, AngleDraw]
type = AngleDraw
trigger1 = time >= 20
scale = 1,1



[State 0, DEKU FX]
type = Explod
trigger1 = !time
anim = BLST193
ID = 193
pos = 0,0
postype = p1
facing = facing
scale = 0.65,0.65
sprpriority = 5

;-------------------------------------
;---------------------------------------
;------------------------------------
;Change Pallete
[State 0]
type = null
TriggerALL = NumHelper(9054) = 0
trigger1 = var(55) = 14
trigger1 = var(55):= 1
trigger2 = var(55) = 1
trigger2 = Cond(teamside=2,Command="fwd",Command="back")
trigger2 = var(55):= 14

[State 0]
type = varadd
TriggerALL = NumHelper(9054) = 0
trigger1 = TeamSide = 1 && Command = "fwd"
trigger2 = TeamSide = 2 && Command = "back"
var(55) = 1

[State 0]
type = varadd
TriggerALL = NumHelper(9054) = 0
trigger1 = TeamSide = 1 && Command = "back"
trigger2 = TeamSide = 2 && Command = "fwd"
var(55) = -1

[State 0,PlaySnd]
type = PlaySnd
TriggerALL = NumHelper(9054) = 0
trigger1 = Command = "fwd"|| Command = "back"
value = BLST600,1
volumescale = 100
ignorehitpause = 1

[State 0,Helper]
type = Helper
TriggerALL = NumHelper(9054) = 0
trigger1 = Command = "fwd" || Command = "back"
helpertype = normal
ID = 9059
name = "9059"
stateno = 9059
pos = 0,0
postype = p1
facing = 1
ownpal = 1
