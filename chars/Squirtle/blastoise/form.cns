; Blastoise form loaded through CommonFX prefix BLST.
; State numbers that already belong to Squirtle are moved by 200000.
; Basic movement and hit states stay Squirtle's, and the sprites swap while var(42) = 1.

[Statedef 19800]
type = S
movetype = I
physics = S
anim = 0
ctrl = 0
velset = 0,0
sprpriority = 2

[State 19800, flag]
type = VarSet
trigger1 = time = 0
var(42) = 1
ignorehitpause = 1

[State 19800, lock]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 19800, shake]
type = EnvShake
trigger1 = time = 0
time = 28
ampl = -6
freq = 110

[State 19800, pal]
type = PalFX
trigger1 = time = 0
time = 32
add = 40,90,160
sinadd = 30,50,80,40

[State 19800, snd]
type = PlaySnd
trigger1 = time = 10
value = BLST0,0
channel = 0
volumescale = 100
ignorehitpause = 1

[State 19800, body]
type = ChangeAnim
trigger1 = time = 14
value = BLST0

[State 19800, name]
type = ModifyPlayer
trigger1 = time = 14
displayname = "Blastoise"
ignorehitpause = 1

[State 19800, end]
type = ChangeState
trigger1 = time >= 36
value = 0
ctrl = 1

