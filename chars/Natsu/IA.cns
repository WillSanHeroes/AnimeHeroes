[State 0, Change Movelist]
type = ChangeMovelist
trigger1 = var(2) = 0 && var(3) = 0
value = 0
[State 0, Change Movelist]
type = ChangeMovelist
trigger1 = var(3) = 1
value = 1
[State 0, Change Movelist]
type = ChangeMovelist
trigger1 = var(2) = 1
value = 2

[State 0, Change Character Name]
type = ModifyPlayer
trigger1 = var(2) = 0 && var(3) = 0
displayname = "Natsu"
[State 0, Change Character Name]
type = ModifyPlayer
trigger1 = var(3) = 1
displayname = "Natsu -Modo Raienryu-"
[State 0, Change Character Name]
type = ModifyPlayer
trigger1 = var(2) = 1
displayname = "Natsu -Dragon Force-"

[State -2, Secret]
type = VarSet
triggerall = GameMode != "arcade"
triggerall = GameMode != "teamcoop"
triggerall = GameMode != "survival"
triggerall = GameMode != "survivalcoop"
triggerall = GameMode != "events"
triggerall = roundsexisted = 0
triggerall = roundstate < 2
trigger1 = command = "s"
trigger1 = command = "holddown"
var(9) = 1

[State 0, Happy]
type = Helper
triggerall = palno = 2 || palno = 3
trigger1 = numhelper(4000) = 0
helpertype = normal
name = "Happy"
ID = 4000
stateno = 4000
pos = -30,-20
postype = p1
facing = 1
ownpal = 1
size.xscale = .5
size.yscale = .5
supermovetime = 999

[State 0, Back to normal]
type = Changestate
trigger1 = var(9) = 0
triggerall = var(2) = 1
triggerall = var(41) = 0
triggerall = roundstate = 2
triggerall = stateno = 0||stateno = 20||stateno = 500
value = 1605
ignorehitpause = 1

[State -2, EffectsColor]
type = RemapPal
trigger1 = var(2)=0 && var(3)=0
source = 3,0
dest = 3,7
[State -2, EffectsColor]
type = RemapPal
trigger1 = var(3)=1
source = 3,0
dest = 3,38
[State -2, EffectsColor]
type = RemapPal
trigger1 = var(2)=1
source = 3,0
dest = 3,2

[State 0, PowerAdd Base]
type = poweradd
triggerall = power < powermax
triggerall = stateno != [1000,3500]
triggerall = stateno != [30000,30499]
triggerall = stateno != [21100,21899]
triggerall = RoundState = 2
triggerall = var(2) = 0
triggerall = alive = 1
trigger1 = 1
value = 1
ignorehitpause = 1

[State 0, PowerAdd Dragon Force]
type = poweradd
triggerall = power < powermax
triggerall = stateno != [1000,3500]
triggerall = stateno != [30000,30499]
triggerall = stateno != [21100,21899]
triggerall = RoundState = 2
triggerall = var(2) = 1
triggerall = alive = 1
trigger1 = 1
value = 2
ignorehitpause = 1

[State 0, PowerAdd EnryuMode]
type = poweradd
triggerall = power < powermax
triggerall = stateno != [1000,3500]
triggerall = stateno != [30000,30499]
triggerall = stateno != [21100,21899]
triggerall = RoundState = 2
triggerall = var(3) = 2
triggerall = alive = 1
trigger1 = 1
value = 2
ignorehitpause = 1

;----------------------------------
; Awake System
;----------------------------------
[state > aura awakening fx]
type = helper
triggerall = var(2) != 1
triggerall = (stateno != [3000, 4999]) && var(41)=1
trigger1 = !numhelper(30508)
stateno = 30508
id = 30508
ownpal = 1
postype = p1
size.mid.pos = (const(size.mid.pos.x) + 0), 0
size.head.pos = 0, (var(53))
size.xscale = .15
size.yscale = .2
supermovetime = 999
pausemovetime = 999

[state 0, Low Life]
type = palfx
triggerall = roundstate = 2
triggerall = alive
triggerall = life <= 300
trigger1 = time % (30 + (life / 50)) = 0
time = 40
add = 0, (-22 + floor(life / 15)), (-22 + floor(life / 15))
sinadd = 0, (-22 + floor(life / 15)), (-22 + floor(life / 15)), (-22 + floor(life / 15))
color = 200 + floor(life / 17.6)
ignorehitpause = 1

[State 0, Esconder Barra]
type = RemoveExplod
trigger1 = stateno = [3100,3110]
id = 30900
ignorehitpause = 1
[State 0, Esconder Barra]
type = RemoveExplod
trigger1 = stateno = [3100,3110]
id = 30902
ignorehitpause = 1
[State 0, Esconder Barra]
type = RemoveExplod
trigger1 = stateno = [3200,3202]
id = 30900
ignorehitpause = 1
[State 0, Esconder Barra]
type = RemoveExplod
trigger1 = stateno = [3200,3202]
id = 30902
ignorehitpause = 1

;Repulso da Barra Cheia
[state 0]
type = helper
triggerall = alive
triggerall = var(41) = 1
trigger1 = var(40) >= 1000
stateno = 99005
id = 30105
pos = 0, -25
postype = p1
ownpal = 1
size.xscale = .1
size.yscale = .1
supermovetime = 999
pausemovetime = 999
persistent = 1
ignorehitpause = 1

;===============================================================================
; Awake Bar:
;-------------------------------------------------------------------------------
[State 0, Incrementar Barra (condições)]
type = VarAdd
triggerall = alive
triggerall = var(41) = 0
triggerall = stateno != [3100,3202] ;Impede aumentar no ULT
triggerall = stateno != 4900 ;Impede aumentar no ULT transformado
trigger1 = StateNo = [150,152] ; IDs dos estados padrão de guarda
trigger2 = movetype = H ; Estado de sofrer dano
trigger3 = movehit || helper,movehit  ; Estados de causar dano
var(40) = 1          ; Adiciona ponto por frame
ignorehitpause = 1

[State 0, Incrementar Barra (charge)]
type = VarAdd
triggerall = alive
triggerall = var(41) = 0
triggerall = timemod = 3,0
trigger1 = StateNo = 500
var(40) = 3
ignorehitpause = 1

[State 0, Limite Máximo da Barra]
type = VarSet
trigger1 = var(40) > 1000
var(40) = 1000
ignorehitpause = 1

[State 0, Decrementar Barra]
type = VarAdd
triggerall = var(40) > 0
triggerall = var(41) = 1
triggerall = RoundState = 2
triggerall = alive = 1
trigger1 = (GameTime%2) = 0
var(40) = -1
ignorehitpause = 1

[State 0, Variavel de barra cheia]
type = VarSet
trigger1 = var(40) >= 1000       ; Só ativa se a barra estiver cheia
var(41) = 1
ignorehitpause = 1

[State 0, Variavel de barra vazia]
type = VarSet
trigger1 = var(40) <= 0       ; Só ativa se a barra estiver cheia
trigger2 = roundstate != 2
var(41) = 0
ignorehitpause = 1

[State 0, Impedir Barra Negativa]
type = VarSet
trigger1 = var(40) < 0
var(40) = 0
ignorehitpause = 1

[State -2, Remover Fundo da Barra]
type = RemoveExplod
triggerall = palno < 10
triggerall = roundstate != 2
trigger1 = numexplod(30900)
ID = 30900
ignorehitpause = 1
[State -2, Remover Fundo da Barra]
type = RemoveExplod
triggerall = palno < 10
triggerall = roundstate != 2
trigger1 = numexplod(30902)
ID = 30902
ignorehitpause = 1

; ===================================================
; HUD CUSTOMIZADO:(Transform Bar)
; ===================================================

; 1. LÓGICA DO CRONÔMETRO DE VISIBILIDADE (Apenas no Charge)
[State -2, Ativar Timer de Visibilidade]
type = VarSet
trigger1 = stateno = 500  
fvar(39) = 60                  
ignorehitpause = 1

[State -2, Reduzir Timer]
type = VarSet
trigger1 = fvar(39) > 0
fvar(39) = fvar(39) - 1         
ignorehitpause = 1

; 2. CALCULAR ESCALA DO PREENCHIMENTO
[State -2, Calcular Escala (Decimal)]
type = VarSet
triggerall = palno < 10
trigger1 = 1
fvar(37) = (var(40) / 1000.0) * 0.1 
ignorehitpause = 1

; 3. CRIAR A BARRA DE FUNDO 
[State -2, Fundo da Barra]
type = Explod
triggerall = roundstate = 2
triggerall = stateno != [3100,3202]
trigger1 = !NumExplod(30900) 
trigger1 = fvar(39) > 0 || var(40) >= 1000 || var(41) = 1
anim = 30900
id = 30900
pos = 0,5
postype = p1
facing = 1
bindtime = -1
removetime = -1
scale = .102, .12
sprpriority = 8
ownpal = 1
ignorehitpause = 1

; 4. CRIAR A BARRA DE PREENCHIMENTO
[State -2, Preenchimento Dinamico]
type = Explod
triggerall = roundstate = 2
triggerall = stateno != [3100,3202]
trigger1 = !NumExplod(30902) 
trigger1 = fvar(39) > 0 || var(40) >= 1000 || var(41) = 1
anim = 30902
id = 30902
pos = 0,5
postype = p1
facing = 1
bindtime = -1
removetime = -1
scale = 0, .12
sprpriority = 9           
ownpal = 1
ignorehitpause = 1

; 5. CRIAR EFEITO CHOQUE
[State -2, Choque]
type = Explod
triggerall = roundstate = 2
triggerall = !NumExplod(30324)             ; Só cria se AINDA NÃO existir
trigger1 = var(40) >= 1000                ; Quando a barra estiver cheia
trigger2 = var(41) = 1                    ; Ou enquanto estiver ativada
anim = 30324
id = 30324
pos = 0,5
postype = p1
facing = 1
bindtime = -1
removetime = -1
scale = .2,.05                       ; Ajustado para enquadrar na barra
sprpriority = 10                          ; Fica à frente da barra
ownpal = 1
removeongethit = 0
ignorehitpause = 1
supermovetime = 999
pausemovetime = 999

; 6. REMOVER O FUNDO QUANDO OCIOSO
[State -2, Remover Fundo Ocioso]
type = RemoveExplod
trigger1 = fvar(39) <= 0       ; O timer de carregar acabou
trigger1 = var(40) < 1000      ; Não está cheia
trigger1 = var(41) = 0         ; E não está no estado transformado
id = 30900
ignorehitpause = 1

; 7. REMOVER PREENCHIMENTO QUANDO OCIOSO
[State -2, Remover Barra Ociosa]
type = RemoveExplod
trigger1 = fvar(39) <= 0       
trigger1 = var(40) < 1000     
trigger1 = var(41) = 0        
id = 30902
ignorehitpause = 1

; 8. REMOVER EFEITO CHOQUE
[State -2, Remover Barra Ociosa]
type = RemoveExplod
trigger1 = fvar(39) <= 0       
trigger1 = var(40) < 1000     
trigger1 = var(41) = 0        
id = 30324
ignorehitpause = 1

; ===================================================
; 9. ATUALIZADORES VISUAIS (ModifyExplod) - Apenas para ID 30902
; ===================================================
[State -2, Atualizar Tamanho]
type = ModifyExplod
triggerall = roundstate = 2
triggerall = NumExplod(30902)
trigger1 = var(40) < 1000
trigger1 = var(41) = 0
id = 30902
scale = fvar(37),.12
ignorehitpause = 1

[State -2, Atualizar Cheia Solida]
type = ModifyExplod
triggerall = NumExplod(30902)
triggerall = (GameTime % 16) < 8
trigger1 = var(40) >= 1000
trigger2 = var(41) = 1
id = 30902
scale = fvar(37),.12
trans = none
ignorehitpause = 1

[State -2, Atualizar Cheia Brilhando]
type = ModifyExplod
triggerall = NumExplod(30902)
triggerall = (GameTime % 16) >= 8
trigger1 = var(40) >= 1000
trigger2 = var(41) = 1
id = 30902
scale = fvar(37),.12
trans = add
ignorehitpause = 1
