value = 5120+var(11)

[State 5120, 1b] ;Get up anim (for hit up/diag-up)
type = ChangeAnim
triggerall = time = 0
triggerall = Life > 0
trigger1 = (anim = [5111,5119])+var(11)
trigger1 = SelfAnimExist(5120 + (anim % 10))
value = (5120+var(11)) + (anim % 10)

