;===============================================================================
;--------------------------Constantes Básicas-----------------------------------
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

; Anti Bugs
[State 0, RemoveExplod]
type = RemoveExplod
trigger1 = ishelper
[State 0, DestroySelf]
type = DestroySelf
trigger1 = ishelper

[State 0, 1]
type = ChangeAnim
trigger1 = (Anim != 0+var(11)+var(19) && (Anim != 5+var(11)+var(19)))
trigger2 = (Anim = 5+var(11)+var(19)) && AnimTime = 0
value = 0+var(11)+var(19)

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050
;-------------------------------------------------------------------------------
; Stand to Crouch
[Statedef 10]
type    = C
physics = C
anim = 10+var(11)+var(19)

[State 10, 1]
type = VelMul
trigger1 = Time = 0
x = .75

[State 10, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 11
;---------------------------------------------------------------------------
; Crouching
[Statedef 11]
type    = C
physics = C
anim = 11+var(11)+var(19)
sprpriority = 0

[State 0, 1]
type = ChangeAnim
trigger1 = (Anim != 11+var(11)+var(19) && (Anim != 6+var(11)+var(19) && Anim != 12006))
trigger2 = (Anim = 6+var(11)+var(19) || anim = 12006) && AnimTime = 0
value = 11+var(11)+var(19)
;---------------------------------------------------------------------------
; Crouch to Stand
[Statedef 12]
type    = S
physics = S
anim = 12+var(11)+var(19)

[State 12, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = (Anim != 20+var(11)+var(19) && (Anim != 5+var(11)+var(19)))
trigger2 = (Anim = 5+var(11))+var(19) && AnimTime = 0
value = 20+var(11)+var(19)

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = (Anim != 21+var(11)+var(19) && (Anim != 5+var(11)+var(19)))
trigger2 = (Anim = 5+var(11)+var(19)) && AnimTime = 0
value = 21+var(11)+var(19)

; Super Dash
[State -1, Super Dash]
type = ChangeState
value = 690
triggerall = !ailevel
triggerall = power >= 200
triggerall = command = "y"
trigger1 = ctrl
;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40+var(11)+var(19)
ctrl = 0
sprpriority = 1

[State 0, RemoveExplod]
type = RemoveExplod
trigger1 = time = 0
id = 1230

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1
;---------------------------------------------------------------------------
; AirJump Start
[Statedef 45]
type    = A
physics = N
ctrl = 0
velset = 0,0

[State 0, RemoveExplod]
type = RemoveExplod
trigger1 = time = 0
id = 1230

[State 45, 1]
type = ChangeAnim
trigger1 = SelfAnimExist(44)
value = 44+var(11)+var(19)

[State 45, 2]
type = ChangeAnim
trigger1 = !SelfAnimExist(44)
value = 41+var(11)+var(19)

[State 45, 3]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 45, 4]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 45, 5]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 45, 6]
type = VelSet
trigger1 = Time = 2
x = ifelse(sysvar(1)=0, const(velocity.airjump.neu.x), ifelse(sysvar(1)=1, const(velocity.airjump.fwd.x), const(velocity.airjump.back.x)))
y = const(velocity.airjump.y)

[State 45, 7]
type = ChangeState
trigger1 = Time = 2
value = 50
ctrl = 1
;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 0, RemoveExplod]
type = RemoveExplod
trigger1 = time = 0
id = 1230

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))+var(11)+var(19)

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
persistent = 0
value = 44+var(11)+var(19)
;---------------------------------------------------------------------------
; Jump Down (empty state for compatibility)
[Statedef 51]
type    = A
physics = A

[State 0, RemoveExplod]
type = RemoveExplod
trigger1 = time = 0
id = 1230

[State 51, 1]
type = Null
trigger1 = 1
;---------------------------------------------------------------------------
; Jump Land
[Statedef 52]
type    = S
physics = S
ctrl = 0
anim = 47+var(11)+var(19)

[State 0, RemoveExplod]
type = RemoveExplod
trigger1 = time = 0
id = 1230

[State 0, Land]
type = Explod
trigger1 = time = 0
anim = 7014
ID = 7014
pos = -1,1
postype = p1
facing = 1
vfacing = 1
bindtime = 1
removetime = -2
scale = .4,.4
sprpriority = 1
ontop = 0
ownpal = 1
removeongethit = 0
ignorehitpause = 1
supermovetime = 999999
pausemovetime = 999999

[State 0, EnvShake]
type = EnvShake
trigger1 = var(2) >= 2 && time = 0
time = 10

[State 52, 1]
type = VelSet
trigger1 = Time = 0
y = 0

[State 52, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, 3]
type = CtrlSet
trigger1 = Time = 9
value = 1

[State 52, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1
;===============================================================================
; Correr Adelante:
;-------------------------------------------------------------------------------
[Statedef 60]
type    = A
movetype= I
physics = N
juggle  = 1
velset = 0,0
ctrl = 0
anim = 100+var(11)+var(19)
sprpriority = 2

[State 0, Explod]
type = Explod
trigger1 = time >= 2 && timemod = 10,0 && pos y >= 0
anim = 7022
ID = 1051
pos = 0,0
postype = p1
facing = 1
vfacing = 1
bindtime = 1
removetime = -2
scale = .5*Helper(999999),Fvar(16),.5*Helper(999999),Fvar(16)
sprpriority = 1
ontop = 0
ownpal = 1
removeongethit = 1
ignorehitpause = 1
supermovetime = 999999
pausemovetime = 999999

[State 0, VelSet]
type = VelSet
trigger1 = animelem = 2
x = 8+(var(2)*1.5)

[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = Animelem = 5
statetype = A
movetype = I
physics = A

[State 0, VelSet]
type = VelSet
trigger1 = animelem = 5
x = 2.5

[State 0, VelSet]
type = VelSet
triggerall = time >= 5 && pos y < 0
trigger1 = command = "holdup" && (!ailevel)
trigger2 = p2bodydist y < -15 && ailevel
y = -2.5

[State 0, VelSet]
type = VelSet
triggerall = time >= 5 && pos y < 0
trigger1 = command = "holddown" && (!ailevel)
trigger2 = p2bodydist y > 15 && ailevel
y = 2.5

[State 0, VelSet]
type = VelSet
triggerall = time >= 5
trigger1 = command != "holdup" && command != "holddown" && (!ailevel)
trigger2 = (p2bodydist y = [-15,15]) && ailevel
y = 1.5

[State 0, VelSet]
type = VelSet
trigger1 = time > 2
trigger1 = pos y < 0
trigger1 = command != "holddown"
trigger1 = command != "holdup"
y = 1

[State 0, PosSet]
type = PosSet
trigger1 = pos y >= 0
y = 0

[State 0, ChangeState]
type = ChangeState
trigger1 = command = "holdup" && pos y >= 0 && (!ailevel)
value = 40

[State 0, Air Dash Wave]
type = Explod
trigger1 = Time = 2 && pos y < 0
anim = 7035
ID = 7035
pos = 5*Helper(999999),Fvar(16),-25*Helper(999999),Fvar(16)
postype = p1
facing = 1
vfacing = 1
bindtime = 1
removetime = -2
scale = .5*Helper(999999),Fvar(16),.5*Helper(999999),Fvar(16)
sprpriority = 1
ontop = 1
ownpal = 1
removeongethit = 1
ignorehitpause = 1
supermovetime = 999999
pausemovetime = 999999

[State 0, Speed FX]
type = Explod
trigger1 = Time >= 2 && timemod = 5,0
anim = 580
ID = 001
pos = -10*Helper(999999),Fvar(16),-30*Helper(999999),Fvar(16)
postype = p1
facing = 1
vfacing = 1
bindtime = 1
removetime = -2
scale = .2*Helper(999999),Fvar(16),.4*Helper(999999),Fvar(16)
sprpriority = 3
ontop = 1
ownpal = 1
removeongethit = 1
ignorehitpause = 1
Trans = Add
Vel = -.5,0
supermovetime = 999999
pausemovetime = 999999

[State 200, End]
type = ChangeState
trigger1 = command = "down" && pos y >= 0 && (!ailevel)
value = 10
ctrl = 1

[State 200, End]
type = ChangeState
trigger1 = command = "a" && pos y >= 0 && (!ailevel)
value = 200

[State 200, End]
type = ChangeState
trigger1 = command = "b" && pos y >= 0 && (!ailevel)
value = 300

[State 200, End]
type = ChangeState
trigger1 = command = "c" && pos y >= 0 && power >= 200 && (!ailevel)
value = 400

[State 200, End]
type = ChangeState
trigger1 = command = "a" && pos y < 0 && (!ailevel)
value = 600

[State 200, End]
type = ChangeState
trigger1 = command = "b" && pos y < 0 && (!ailevel)
value = 620

[State 200, End]
type = ChangeState
trigger1 = command = "c" && pos y < 0 && power >= 200 && (!ailevel)
value = 640

; Super Dash
[State -1, Super Dash]
type = ChangeState
value = 690
triggerall = power >= 200
trigger1 = command = "y"

[State 200, End]
type = ChangeState
triggerall = time >= 10
trigger1 = ailevel = 0 && command != "holdfwd"
trigger2 = ailevel > 0 && p2bodydist x < 30
trigger3 = ailevel > 0 && time = 50+random%50
trigger4 = ailevel > 0 && frontedgebodydist < 100
trigger5 = ailevel > 0 && p2movetype = A && var(2) = 0
value = ifelse(pos y < 0,50,0)
ctrl = 1
