trigger1 = AnimTime = 0
trigger1 = Anim != 5040+var(11)
trigger2 = Time = 0
trigger2 = Anim != 5035+var(11)
value = 5040+var(11)

[State 5040, 3]
type = CtrlSet
trigger1 = HitOver
value = 1

[State 5040, 4]
