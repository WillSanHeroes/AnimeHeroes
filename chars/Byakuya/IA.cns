ignorehitpause = 1
supermovetime = 999
pausemovetime = 999

; 6. REMOVER O FUNDO QUANDO OCIOSO
[State -2, Remover Fundo Ocioso]
type = RemoveExplod
trigger1 = fvar(39) <= 0
trigger1 = var(40) < 1000
trigger1 = var(41) = 0
id = 30900
ignorehitpause = 1

; 7. REMOVER PREENCHIMENTO QUANDO OCIOSO
[State -2, Remover Barra Ociosa]
type = RemoveExplod
trigger1 = fvar(39) <= 0
trigger1 = var(40) < 1000
trigger1 = var(41) = 0
id = 30902
