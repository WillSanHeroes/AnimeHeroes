[State -2, Secret]
type = VarSet
triggerall = GameMode != "arcade"
triggerall = GameMode != "teamcoop"
triggerall = GameMode != "survival"
triggerall = GameMode != "survivalcoop"
triggerall = GameMode != "events"
triggerall = roundsexisted = 0
triggerall = roundstate < 2
trigger1 = command = "s"
trigger1 = command = "holddown"
var(9) = 1

[State 0, PowerAdd Base]
type = poweradd
triggerall = power < powermax
triggerall = RoundState = 2
triggerall = stateno != [520,530]
triggerall = stateno != [1000,3500]
triggerall = alive = 1
trigger1 = 1
value = 1
ignorehitpause = 1

[State 0, Change Movelist]
type = ChangeMovelist
trigger1 = var(2) = 0 && var(1) = 0
value = 0
[State 0, Change Movelist]
type = ChangeMovelist
trigger1 = var(2) = 1
value = 1
[State 0, Change Movelist]
type = ChangeMovelist
trigger1 = var(1) = 1
value = 2

[State 0, Change Character Name]
type = ModifyPlayer
trigger1 = var(2) = 0 && var(1) = 0
displayname = "Byakuya"
[State 0, Change Character Name]
type = ModifyPlayer
trigger1 = var(2) = 1
displayname = "Byakuya -Senbonzakura Kageyoshi-"
[State 0, Change Character Name]
type = ModifyPlayer
trigger1 = var(1) = 1
displayname = "Byakuya -Senkei S. Kageyoshi-"

[State 0, Back to normal]
type = ChangeState
triggerall = var(9) = 0
triggerall = var(1) = 1
triggerall = stateno = 0||stateno = 20||stateno = 500
triggerall = var(41) = 0
trigger1 = 1
value = 711

[State -2, EffectsColor]
type = RemapPal
trigger1 = var(1) = 0
source = 3,0
dest = 3,4
[State -2, EffectsColor]
type = RemapPal
trigger1 = var(1) = 1
source = 3,0
dest = 3,0

;===============================================================================
; Despertar (Awake)
;===============================================================================
[state > aura awakening fx]
type = helper
triggerall = var(1) != 1
triggerall = (stateno != [3000, 4999]) && var(41)=1
trigger1 = !numhelper(30508)
stateno = 30508
id = 30508
ownpal = 1
postype = p1
size.mid.pos = (const(size.mid.pos.x) + 0), 0
size.head.pos = 0, (var(53))
size.xscale = .15
size.yscale = .2
supermovetime = 999
pausemovetime = 999

[state 0, Low Life]
type = palfx
triggerall = roundstate = 2
triggerall = alive
triggerall = life <= 300
trigger1 = time % (30 + (life / 50)) = 0
time = 40
add = 0, (-22 + floor(life / 15)), (-22 + floor(life / 15))
sinadd = 0, (-22 + floor(life / 15)), (-22 + floor(life / 15)), (-22 + floor(life / 15))
color = 200 + floor(life / 17.6)
ignorehitpause = 1

[State 0, Esconder Barra]
type = RemoveExplod
trigger1 = stateno = [720,725] || stateno = 3000 || stateno = 3100
id = 30900
ignorehitpause = 1
[State 0, Esconder Barra]
type = RemoveExplod
trigger1 = stateno = [720,725] || stateno = 3000 || stateno = 3100
id = 30902
ignorehitpause = 1

;Repulso da Barra Cheia
[state 0]
type = helper
triggerall = alive
triggerall = var(41) = 1
trigger1 = var(40) >= 1000
stateno = 99005
id = 30105
pos = 0, -25
postype = p1
ownpal = 1
size.xscale = .1
size.yscale = .1
supermovetime = 999
pausemovetime = 999
persistent = 1
ignorehitpause = 1

;===============================================================================
; Awake Bar:
;-------------------------------------------------------------------------------
[State 0, Incrementar Barra (condicoes)]
type = VarAdd
triggerall = alive
triggerall = var(41) = 0
triggerall = stateno != [720,725] && stateno != 3000 && stateno != 3100
trigger1 = StateNo = [150,152] ; IDs dos estados padrao de guarda
trigger2 = movetype = H ; Estado de sofrer dano
trigger3 = movehit || helper,movehit  ; Estados de causar dano
var(40) = 1          ; Adiciona ponto por frame
ignorehitpause = 1

[State 0, Incrementar Barra (charge)]
type = VarAdd
triggerall = alive
triggerall = var(41) = 0
triggerall = timemod = 3,0
trigger1 = StateNo = 500
var(40) = 3
ignorehitpause = 1

[State 0, Limite Maximo da Barra]
type = VarSet
trigger1 = var(40) > 1000
var(40) = 1000
ignorehitpause = 1

[State 0, Decrementar Barra]
type = VarAdd
triggerall = var(40) > 0
triggerall = var(41) = 1
triggerall = RoundState = 2
triggerall = alive = 1
trigger1 = (GameTime%2) = 0
var(40) = -1
ignorehitpause = 1

[State 0, Variavel de barra cheia]
type = VarSet
trigger1 = var(40) >= 1000
var(41) = 1
ignorehitpause = 1

[State 0, Variavel de barra vazia]
type = VarSet
trigger1 = var(40) <= 0
trigger2 = roundstate != 2
var(41) = 0
ignorehitpause = 1

[State 0, Impedir Barra Negativa]
type = VarSet
trigger1 = var(40) < 0
var(40) = 0
ignorehitpause = 1

[State -2, Remover Fundo da Barra]
type = RemoveExplod
triggerall = roundstate != 2
trigger1 = numexplod(30900)
ID = 30900
ignorehitpause = 1
[State -2, Remover Fundo da Barra]
type = RemoveExplod
triggerall = roundstate != 2
trigger1 = numexplod(30902)
ID = 30902
ignorehitpause = 1

; ===================================================
; HUD CUSTOMIZADO:(Transform Bar)
; ===================================================

; 1. CRONOMETRO DE VISIBILIDADE (Apenas no Charge)
[State -2, Ativar Timer de Visibilidade]
type = VarSet
trigger1 = stateno = 500
fvar(39) = 60
ignorehitpause = 1

[State -2, Reduzir Timer]
type = VarSet
trigger1 = fvar(39) > 0
fvar(39) = fvar(39) - 1
ignorehitpause = 1

; 2. CALCULAR ESCALA DO PREENCHIMENTO
[State -2, Calcular Escala (Decimal)]
type = VarSet
trigger1 = 1
fvar(37) = (var(40) / 1000.0) * 0.1
ignorehitpause = 1

; 3. CRIAR A BARRA DE FUNDO
[State -2, Fundo da Barra]
type = Explod
triggerall = roundstate = 2
triggerall = stateno != [720,725] && stateno != 3000 && stateno != 3100
trigger1 = !NumExplod(30900)
trigger1 = fvar(39) > 0 || var(40) >= 1000 || var(41) = 1
anim = 30900
id = 30900
pos = 0,5
postype = p1
facing = 1
bindtime = -1
removetime = -1
scale = .102, .12
sprpriority = 8
ownpal = 1
ignorehitpause = 1

; 4. CRIAR A BARRA DE PREENCHIMENTO
[State -2, Preenchimento Dinamico]
type = Explod
triggerall = roundstate = 2
triggerall = stateno != [720,725] && stateno != 3000 && stateno != 3100
trigger1 = !NumExplod(30902)
trigger1 = fvar(39) > 0 || var(40) >= 1000 || var(41) = 1
anim = 30902
id = 30902
pos = 0,5
postype = p1
facing = 1
bindtime = -1
removetime = -1
scale = 0, .12
sprpriority = 9
ownpal = 1
ignorehitpause = 1

