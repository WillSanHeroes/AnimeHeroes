;大乱闘スマッシュブラサーズ名物のボーナスゲームで・る　ターゲットを壊せ!!　だと
;ルール設定も出来るんでなんかの大会に使ってみて下さいナ。

;作成 			AlGod(ヨコセイ)

;開発進行度		97%
;----------------------------------------------------------------------------------------------------

[Info]
name         = "Kuriboh"  	;キャラの名前
displayname  = "Kuriboh's"	 	;表示されるキャラの名前
versiondate  = 11,22,2000    			;キャラの更新情報
mugenversion = 1,9,2011  			;キャラが動くmugenのバージョン
author       = "AlGod(ヨコセイ)" 			;キャラの製作者名
pal.defaults = 1     			;敵としてでるキャラのパレット

;----------------------------------------------------------------------------------------------------

[Files]

;----------------------------------------------------------------------------------------------------
;◆    共通     ◆
;----------------------------------------------------------------------------------------------------
cmd          = sys/Targets.cmd   	 	;キャラのコマンド
cns          = sys/Targets.cns    	;キャラののコンタンツステイト
sprite       = sys/Targets.sff      ;キャラの絵
anim         = sys/Targets.air        	;キャラの動き
sound        = sys/Targets.snd   	;キャラの音
;----------------------------------------------------------------------------------------------------
;◆   ステイト   ◆	(最大9まで登録可能)
;----------------------------------------------------------------------------------------------------
st           = st/Break.cns  ;キャラの動作
st0          = st/Target.cns  		;的のステイト
st1	     = st/Config.cns		;コフィングステイト
st2	     = st/Override.cns      ;オーバーライドステイト
stcommon     = common1.cns 		 	;共通ファイル
;----------------------------------------------------------------------------------------------------
;◆カラーパレット◆	(最大12まで登録可能)
;----------------------------------------------------------------------------------------------------
pal1         = pal/red.act

